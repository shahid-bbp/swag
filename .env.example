# S For Swag Salon Environment Variables
# Copy this file to .env and configure your production values

# Formspree endpoint for appointment enquiry form submissions
# Obtain endpoint from https://formspree.io (e.g., https://formspree.io/f/xyzabcop)
FORMSPREE_ENDPOINT=

# Canonical Public Site URL (used for sitemaps and OpenGraph tags)
PUBLIC_SITE_URL=https://sforswag.com
