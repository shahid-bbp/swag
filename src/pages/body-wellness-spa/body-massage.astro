---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCategoryView from '../../components/ServiceCategoryView.astro';
import { servicesData } from '../../data/services';
import { siteConfig } from '../../data/site';

const category = servicesData.find((c) => c.slug === 'body-wellness-spa')!;

const seo = {
  title: "Therapeutic Body Massages | Aroma, Swedish & Deep Tissue Kochi",
  description: "Aroma Bliss (₹2,500/₹3,000), Swedish Massage (₹3,300/₹3,700), Deep Tissue (₹4,000/₹5,000), Foot Reflexology (₹2,500) at S For Swag Spa Kochi.",
  canonical: `${siteConfig.siteUrl}/body-wellness-spa/body-massage/`,
};
---

<BaseLayout seo={seo}>
  <ServiceCategoryView category={category} activeSubcategorySlug="body-massage" />
</BaseLayout>
