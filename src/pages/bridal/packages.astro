---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BridalPackageComparison from '../../components/BridalPackageComparison.astro';
import BrochureCTA from '../../components/BrochureCTA.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import JourneySection from '../../components/JourneySection.astro';
import FAQSection from '../../components/FAQSection.astro';
import { visitGuides } from '../../data/visit-guides';
import { siteConfig } from '../../data/site';

const seo = {
  title: "Bridal Packages (Silver, Gold, Platinum) | S For Swag Kochi",
  description: "Silver Bride, Gold Bride, and Platinum Bride packages at S For Swag Salon, MG Road Kochi. Inclusions and pre-bridal preparation guide.",
  canonical: `${siteConfig.siteUrl}/bridal/packages/`,
};

const breadcrumbs = [
  { name: 'Services', url: '/services/' },
  { name: 'Bridal Studio', url: '/bridal/' },
  { name: 'Packages', url: '/bridal/packages/' },
];
---

<BaseLayout seo={seo}>
  <section class="page-hero-banner bg-[#F5ECDB] border-b border-[#eeda9b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-5 sm:mb-6" />
      <div class="max-w-3xl space-y-4">
        <span class="text-xs uppercase tracking-[0.24em] text-[#75451d] font-semibold">Bridal Collections</span>
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          Silver, Gold <span class="font-accent">&</span> Platinum <br />
          <span class="italic font-normal">Bridal Packages</span>
        </h1>
        <p class="text-sm sm:text-base text-[#5C4D3E] leading-relaxed">
          Comprehensive bridal journeys designed to prepare your hair, skin, and nails before the big day, culminating in signature wedding makeup and hairstyling.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-16">
      <BridalPackageComparison />

      <!-- Bridal Brochure Download CTA -->
      <BrochureCTA
        title="Download the Complete Bridal & Salon Brochure"
        eyebrow="Bridal Collections & Inclusions"
        description="Review our full bridal service guide, customised pre-wedding countdown roadmap, and bridal party draping rituals in the official brochure."
      />

      <div id="book-appointment">
        <EnquiryForm
          preselectedService="Bridal Studio — Gold Bride Package"
          title="Book Your Bridal Package Consultation"
          subtitle="Let our bridal experts personalize your pre-wedding package according to your functions."
        />
      </div>
    </div>
  </section>
  <JourneySection title={visitGuides.packages.title} description={visitGuides.packages.description} steps={visitGuides.packages.steps} tinted />
  <FAQSection title="Before reserving your bridal package." items={visitGuides.packages.faqs} />
</BaseLayout>
