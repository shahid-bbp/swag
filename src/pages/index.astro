---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import UnisexShowcase from '../components/UnisexShowcase.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import BridalBanner from '../components/BridalBanner.astro';
import ArtOfBeauty from '../components/ArtOfBeauty.astro';
import ContactSection from '../components/ContactSection.astro';
import ExperienceFinder from '../components/ExperienceFinder.astro';
import EditorialFeature from '../components/EditorialFeature.astro';
import FAQSection from '../components/FAQSection.astro';
import { homeQuestions } from '../data/visit-guides';
import { siteConfig } from '../data/site';

const seo = {
  title: `${siteConfig.name} — ${siteConfig.tagline} | Premium Unisex Salon Kochi`,
  description: "S For Swag is a luxury unisex salon and bridal beauty destination on MG Road, Kochi, Kerala. Expert hair artistry, couture bridal styling, skin care, nails, and wellness.",
  canonical: `${siteConfig.siteUrl}/`,
};
---

<BaseLayout seo={seo}>
  <Hero />
  <AboutSection />
  <ServicesOverview />
  <UnisexShowcase />
  <ExperienceFinder />
  <ExperienceSection />
  <EditorialFeature eyebrow="The art of taking a moment" title="A Little Care. A Little Time. All Yours."
    description="A salon visit can begin with a simple intention: a fresh finish, a familiar ritual, or time to explore something new. Start with how you want to feel and make the details your own."
    image="/images/editorial/A little care.jpg" alt="Illustrative beauty still life with a ceramic bowl, glass bottle and wooden brush in warm light"
    points={['Choose one focus for your visit.', 'Share your routine and your preferences.', 'Leave room for a conversation before deciding.']}
    href="/beauty-lounge/" link="Explore your beauty ritual" tinted />
  <BridalBanner />
  <ArtOfBeauty />
  <EditorialFeature eyebrow="Before the celebration" title="Gather the Details. Find your Bridal Direction."
    description="Your outfit, jewellery and ceremony are part of the same story. Bring them into your beauty consultation so your makeup, hair and draping can be considered together."
    image="/images/editorial/1200 x 800 dress.jpg" alt="Illustrative bridal moodboard with kasavu silk, gold earrings and jasmine"
    points={['Save a few makeup and hairstyle references.', 'Bring outfit and jewellery photographs.', 'Share your dates, venue and ready-by time.']}
    href="/bridal/makeup-and-hair/" link="Plan your bridal look" reverse />
  <FAQSection title="Before your First Visit" items={homeQuestions} tinted />
  <ContactSection />
</BaseLayout>
