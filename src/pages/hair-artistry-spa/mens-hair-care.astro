---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCategoryView from '../../components/ServiceCategoryView.astro';
import { servicesData } from '../../data/services';
import { siteConfig } from '../../data/site';

const category = servicesData.find((c) => c.slug === 'hair-artistry-spa')!;

const seo = {
  title: "Men's Hair Care & Colouring | S For Swag Salon MG Road Kochi",
  description: "Executive men's hair treatments, L'Oréal hair spa, scalp therapies, anti-dandruff care, root touch-up, and global colouring at S For Swag Kochi.",
  canonical: `${siteConfig.siteUrl}/hair-artistry-spa/mens-hair-care/`,
};
---

<BaseLayout seo={seo}>
  <ServiceCategoryView category={category} activeSubcategorySlug="mens-hair-care" />
</BaseLayout>
