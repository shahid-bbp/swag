---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JourneySection from '../components/JourneySection.astro';
import FAQSection from '../components/FAQSection.astro';
import { siteConfig } from '../data/site';

const seo = {
  title: "About Us | S For Swag The Salon by Seematti Kochi",
  description: "Learn about S For Swag — a premium unisex salon by Seematti on MG Road, Kochi. Our beauty philosophy, expert stylists, modern space, and bespoke self-care experience.",
  canonical: `${siteConfig.siteUrl}/about/`,
};

const breadcrumbs = [{ name: 'About Us', url: '/about/' }];
---

<BaseLayout seo={seo}>
  <!-- Hero Banner -->
  <section class="page-hero-banner bg-[#F5ECDB] border-b border-[#eeda9b] relative overflow-hidden">
    <!-- Background Image Layer (Sunlit plaster with botanical shadows) -->
    <div class="absolute inset-0 pointer-events-none">
      <img
        src="/images/salon/page-hero-bg.webp"
        alt="S For Swag luxury salon ambiance"
        class="w-full h-full object-cover object-center"
        width="1024"
        height="438"
        loading="eager"
        decoding="async"
      />
      <!-- Subtle warm gradient: ensures text is purely readable over botanical shadows -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#F5ECDB]/65 via-[#F5ECDB]/35 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbs} class="mb-5 sm:mb-6" />
      <div class="max-w-3xl space-y-4">
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          Where Self Care Becomes <br />
          <span class="italic font-normal">A Beautiful Lifestyle</span>
        </h1>
        <p class="text-base sm:text-lg text-[#5C4D3E] font-serif italic max-w-2xl leading-relaxed">
          "Beauty is not about changing who you are. It is about bringing out what feels right for you."
        </p>
      </div>
    </div>
  </section>

  <!-- Narrative Section -->
  <section class="py-20 lg:py-24 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#b7802c]">Philosophy & Heritage</span>
          <h2 class="text-3xl sm:text-4xl font-serif text-[#28221C]">
            Crafted with Artistry, Powered by Care
          </h2>
          <div class="space-y-4 text-sm sm:text-base text-[#5C4D3E] leading-relaxed">
            <p>
              S for Swag is a premium unisex salon by Seematti, designed for those who believe self-care is not a luxury, but a lifestyle. Set in the vibrant heart of Mahatma Gandhi Road, opposite Seematti in Kacheripady, Kochi, this is a space made for transformations, special celebrations, and simply taking some well-deserved time for yourself.
            </p>
            <p>
              We blend deep industry expertise with modern techniques to offer a seamless beauty experience — from everyday essentials to high-fashion bridal occasions. Our team of skilled hairstylists, beauty therapists, and nail artists are dedicated to understanding your individual preferences and bringing out your signature swag.
            </p>
            <p>
              Every detail in our salon — from the soft amber ambient backlighting and ergonomic leather chairs to our sanitized private rooms and premium product lines — has been curated to ensure you step out feeling confident, radiant, and renewed.
            </p>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a href="/services/" class="luxury-pill-btn luxury-pill-gold">
              Explore Our Services &rarr;
            </a>
            <a href="/contact/#appointment" class="luxury-pill-btn luxury-pill-outline">
              Book Appointment &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-6">
          <div class="rounded-3xl overflow-hidden border-2 border-[#FFFCF6] shadow-xl">
            <img
              src="/images/about/About us 1376 x 768 1image.jpg"
              alt="S For Swag salon reception with a cream and gold desk and illuminated salon sign"
              class="block w-full h-auto object-contain"
              width="1376"
              height="768"
            />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-[#eeda9b] shadow-sm">
              <img
                src="/images/about/278 x 208  2 images 1.jpg"
                alt="Woman with softly styled wavy hair and radiant skin in warm sunlight"
                class="block w-full h-auto object-contain"
                width="834"
                height="624"
              />
            </div>
            <div class="rounded-2xl overflow-hidden border border-[#eeda9b] shadow-sm">
              <img
                src="/images/about/278 x 208  2 images 2.jpg"
                alt="Smiling man with styled hair and a neatly trimmed beard in a bright salon"
                class="block w-full h-auto object-contain"
                width="834"
                height="624"
              />
            </div>
          </div>
        </div>

      </div>

      <!-- Core Pillars -->
      <div class="mt-20 pt-16 border-t border-[#eeda9b] grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="bg-[#FFFCF6] p-6 rounded-2xl border border-[#eeda9b] space-y-2">
          <div class="text-[#b7802c] font-serif text-2xl font-bold">01</div>
          <h3 class="font-serif text-lg text-[#28221C]">Personalised Attention</h3>
          <p class="text-xs text-[#6C5D4F] leading-relaxed">We take time to listen, assess your hair/skin texture, and recommend customized solutions.</p>
        </div>

        <div class="bg-[#FFFCF6] p-6 rounded-2xl border border-[#eeda9b] space-y-2">
          <div class="text-[#b7802c] font-serif text-2xl font-bold">02</div>
          <h3 class="font-serif text-lg text-[#28221C]">Uncompromising Hygiene</h3>
          <p class="text-xs text-[#6C5D4F] leading-relaxed">Medical-grade sterilization of instruments, disposable linens, and strict sanitary protocols.</p>
        </div>

        <div class="bg-[#FFFCF6] p-6 rounded-2xl border border-[#eeda9b] space-y-2">
          <div class="text-[#b7802c] font-serif text-2xl font-bold">03</div>
          <h3 class="font-serif text-lg text-[#28221C]">Prestige Formulations</h3>
          <p class="text-xs text-[#6C5D4F] leading-relaxed">We work exclusively with globally renowned salon brands like L'Oréal Professionnel, Kerastase, and organic botanicals.</p>
        </div>

        <div class="bg-[#FFFCF6] p-6 rounded-2xl border border-[#eeda9b] space-y-2">
          <div class="text-[#b7802c] font-serif text-2xl font-bold">04</div>
          <h3 class="font-serif text-lg text-[#28221C]">Seematti Heritage</h3>
          <p class="text-xs text-[#6C5D4F] leading-relaxed">Backed by the trusted legacy of Seematti, synonymous with South Indian grace, couture, and bridal excellence.</p>
        </div>
      </div>

    </div>
  </section>
  <JourneySection eyebrow="Your first visit" title="Come as you are. Bring your point of view."
    description="You do not need a fully formed look to start a conversation. A few preferences are enough."
    steps={[
      { title: 'Tell us what matters', text: 'Share the occasion, the time you have and the details you would like to focus on.' },
      { title: 'Explore at your pace', text: 'Compare service options and ask about the process before deciding on your appointment.' },
      { title: 'Make a considered choice', text: 'Confirm your preferences, service inclusions and quote with the team before beginning.' },
    ]} tinted />
  <FAQSection title="A place for your questions." items={[
    { question: 'Is S For Swag a unisex salon?', answer: 'Yes. S For Swag offers beauty, hair, nail and wellness services for men and women. Browse the menus for individual service options.' },
    { question: 'How is S For Swag connected to Seematti?', answer: 'S For Swag is The Salon by Seematti, located opposite Seematti on Mahatma Gandhi Road in Kochi.' },
    { question: 'Can I visit for a consultation first?', answer: 'Contact reception with your interests and preferred time so the team can confirm the right consultation arrangement.' },
  ]} />
</BaseLayout>
