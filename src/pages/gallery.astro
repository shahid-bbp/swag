---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../data/site';

const seo = {
  title: "Editorial Gallery | S For Swag Salon & Bridal Studio Kochi",
  description: "Explore our editorial portfolio featuring salon interiors, hair transformations, bridal makeup, nail art, and skincare rituals at S For Swag, MG Road Kochi.",
  canonical: `${siteConfig.siteUrl}/gallery/`,
};

const breadcrumbs = [{ name: 'Gallery', url: '/gallery/' }];

const galleryItems = [
  {
    title: "Luxury Reception & Arches",
    category: "Salon Interior",
    categorySlug: "salon",
    image: "/images/salon/salon-interior.webp",
    alt: "Warm ambient backlit arches and marble reception at S For Swag Salon Kochi",
  },
  {
    title: "Kerala Bridal Elegance",
    category: "Bridal",
    categorySlug: "bridal",
    image: "/images/bridal/bridal-main.webp",
    alt: "South Indian bride wearing temple jewellery and silk saree with traditional bridal makeup",
  },
  {
    title: "Silk Waves & Hair Artistry",
    category: "Hair Artistry",
    categorySlug: "hair",
    image: "/images/hair/hair-care.webp",
    alt: "Glossy brunette silk waves and hair transformation",
  },
  {
    title: "Radiant Skincare Glow",
    category: "Skincare",
    categorySlug: "beauty",
    image: "/images/beauty/beauty-care.webp",
    alt: "Dewy glowing skin after luxury facial treatment at S For Swag",
  },
  {
    title: "Champagne Glitter Nail Couture",
    category: "Nails",
    categorySlug: "nails",
    image: "/images/nails/nail-care.webp",
    alt: "Luxury manicure with champagne gold glitter accents",
  },
  {
    title: "Therapeutic Spa Sanctuary",
    category: "Wellness & Spa",
    categorySlug: "spa",
    image: "/images/spa/spa-wellness.webp",
    alt: "Relaxing head and face pressure point therapy in calm spa suite",
  },
  {
    title: "Modern Men's Styling Station",
    category: "Salon Interior",
    categorySlug: "salon",
    image: "/images/salon/mens-grooming.webp",
    alt: "Men's precision haircut and beard grooming styling chair",
  },
  {
    title: "Editorial Beauty Portrait",
    category: "Beauty",
    categorySlug: "beauty",
    image: "/images/hero/hero-beauty.webp",
    alt: "Editorial luxury beauty portrait with champagne silk wrap",
  },
];
---

<BaseLayout seo={seo}>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Banner -->
  <section class="py-16 sm:py-24 bg-[#EFE2CE] border-b border-[#E8D5B7] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="text-xs uppercase tracking-[0.24em] text-[#8E652E] font-semibold">Visual Portfolio</span>
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          Artistry in Every Detail
        </h1>
        <p class="text-sm sm:text-base text-[#5C4D3E] leading-relaxed">
          A glimpse into the S For Swag experience — where modern luxury design meets precision hair care, nail couture, rejuvenating spa wellness, and timeless bridal glamour.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery Grid Section -->
  <section class="py-20 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mb-12">
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#A77A3F] text-[#FFFCF6] shadow-sm cursor-pointer"
          data-filter="all"
        >
          All Works
        </button>
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F] cursor-pointer"
          data-filter="bridal"
        >
          Bridal
        </button>
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F] cursor-pointer"
          data-filter="hair"
        >
          Hair Artistry
        </button>
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F] cursor-pointer"
          data-filter="nails"
        >
          Nail Studio
        </button>
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F] cursor-pointer"
          data-filter="beauty"
        >
          Skincare & Beauty
        </button>
        <button
          type="button"
          class="gallery-filter-btn px-5 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F] cursor-pointer"
          data-filter="salon"
        >
          Salon Interiors
        </button>
      </div>

      <!-- Asymmetric Editorial Grid -->
      <div id="gallery-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {galleryItems.map((item, idx) => (
          <div
            class="gallery-item group relative rounded-3xl overflow-hidden border border-[#E8D5B7] bg-[#FFFCF6] shadow-sm hover:shadow-xl transition-all duration-500 cursor-pointer"
            data-category={item.categorySlug}
            data-src={item.image}
            data-title={item.title}
            data-desc={item.alt}
          >
            <div class="aspect-[4/3] sm:aspect-[3/4] overflow-hidden relative">
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700"
                width="600"
                height="800"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#28221C]/70 via-[#28221C]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6 text-[#FFFCF6]">
                <span class="text-[10px] uppercase tracking-[0.2em] font-semibold text-[#E8D5B7]">
                  {item.category}
                </span>
                <h3 class="text-xl font-serif font-bold mt-1">
                  {item.title}
                </h3>
                <span class="text-xs text-[#E8D5B7] mt-2 inline-flex items-center gap-1 font-sans">
                  <span>View Full Photo</span> &rarr;
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Lightbox Modal -->
      <div
        id="lightbox-modal"
        class="fixed inset-0 z-50 bg-[#28221C]/90 backdrop-blur-md hidden flex items-center justify-center p-4 sm:p-8"
        role="dialog"
        aria-modal="true"
        aria-label="Image Lightbox"
      >
        <button
          id="lightbox-close"
          type="button"
          class="absolute top-6 right-6 text-white hover:text-[#E8D5B7] p-2 focus:outline-none"
          aria-label="Close Lightbox"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" stroke-width="2"></line>
            <line x1="6" y1="6" x2="18" y2="18" stroke-width="2"></line>
          </svg>
        </button>

        <div class="max-w-4xl max-h-[85vh] flex flex-col items-center">
          <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-w-full max-h-[72vh] object-contain rounded-2xl shadow-2xl border-2 border-[#FFFCF6]"
          />
          <div class="mt-4 text-center text-[#FFFCF6]">
            <h4 id="lightbox-title" class="text-xl font-serif font-bold"></h4>
            <p id="lightbox-caption" class="text-xs text-[#E8D5B7] mt-1 max-w-lg"></p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-[#A77A3F]', 'text-[#FFFCF6]');
        b.classList.add('bg-[#FFFCF6]', 'text-[#4A321C]');
      });
      btn.classList.add('bg-[#A77A3F]', 'text-[#FFFCF6]');
      btn.classList.remove('bg-[#FFFCF6]', 'text-[#4A321C]');

      const filter = btn.getAttribute('data-filter');
      galleryItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'all' || itemCat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox functionality
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalTitle = document.getElementById('lightbox-title');
  const modalCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');

  if (modal && modalImg && modalTitle && modalCaption && closeBtn) {
    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-src') || '';
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';

        modalImg.src = src;
        modalImg.alt = title;
        modalTitle.textContent = title;
        modalCaption.textContent = desc;
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modalImg.src = '';
      document.body.classList.remove('overflow-hidden');
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
