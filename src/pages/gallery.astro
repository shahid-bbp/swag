---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JourneySection from '../components/JourneySection.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { siteConfig } from '../data/site';

const seo = {
  title: "Editorial Gallery | S For Swag Salon & Bridal Studio Kochi",
  description: "Explore our editorial portfolio featuring salon interiors, hair transformations, bridal makeup, nail art, and skincare rituals at S For Swag, MG Road Kochi.",
  canonical: `${siteConfig.siteUrl}/gallery/`,
};

const breadcrumbs = [{ name: 'Gallery', url: '/gallery/' }];

const galleryItems = [
  {
    title: "Luxury Reception & Arches",
    category: "Salon Interior",
    categorySlug: "salon",
    image: "/images/salon/salon-interior.webp",
    alt: "Warm ambient backlit arches and marble reception at S For Swag Salon Kochi",
  },
  {
    title: "Couture Bridal Glamour",
    category: "Bridal",
    categorySlug: "bridal",
    image: "/images/services/bridal-studio.webp",
    alt: "Couture bride wearing golden champagne silk with luminous makeup and delicate earrings",
  },
  {
    title: "Silk Waves & Hair Artistry",
    category: "Hair Artistry",
    categorySlug: "hair",
    image: "/images/optimized/hair-care.webp",
    alt: "Glossy brunette silk waves and hair transformation",
  },
  {
    title: "Radiant Skincare Glow",
    category: "Skincare",
    categorySlug: "beauty",
    image: "/images/beauty/beauty-care.webp",
    alt: "Dewy glowing skin after luxury facial treatment at S For Swag",
  },
  {
    title: "Champagne Glitter Nail Couture",
    category: "Nails",
    categorySlug: "nails",
    image: "/images/optimized/nail-care.webp",
    alt: "Luxury manicure with champagne gold glitter accents",
  },
  {
    title: "Therapeutic Spa Sanctuary",
    category: "Wellness & Spa",
    categorySlug: "spa",
    image: "/images/spa/spa-wellness.webp",
    alt: "Relaxing head and face pressure point therapy in calm spa suite",
  },
  {
    title: "Modern Men's Styling Station",
    category: "Salon Interior",
    categorySlug: "salon",
    image: "/images/salon/mens-grooming.webp",
    alt: "Men's precision haircut and beard grooming styling chair",
  },
  {
    title: "Editorial Beauty Portrait",
    category: "Beauty",
    categorySlug: "beauty",
    image: "/images/hero/model-3-hero.webp",
    alt: "Editorial luxury beauty portrait with champagne silk wrap",
  },
];
galleryItems.push(
  { title: 'The Art of a Little Care', category: 'Editorial inspiration', categorySlug: 'editorial', image: '/images/editorial/ritual.webp', alt: 'AI-generated still life of beauty ritual objects in warm light' },
  { title: 'The Bridal Details', category: 'Editorial inspiration', categorySlug: 'editorial', image: '/images/editorial/bridal-details.webp', alt: 'AI-generated still life of kasavu silk, jasmine and gold jewellery' },
);
const filters = [['all', 'All images'], ['bridal', 'Bridal'], ['hair', 'Hair'], ['nails', 'Nails'], ['beauty', 'Beauty'], ['spa', 'Wellness'], ['salon', 'The salon'], ['editorial', 'Inspiration']];
---

<BaseLayout seo={seo}>
  <section class="page-hero-banner bg-[#F5ECDB] border-b border-[#eeda9b] relative overflow-hidden">
    <!-- Background Image Layer (Sunlit plaster with botanical shadows) -->
    <div class="absolute inset-0 pointer-events-none">
      <img
        src="/images/salon/page-hero-bg.webp"
        alt="S For Swag luxury salon ambiance"
        class="w-full h-full object-cover object-center"
        width="1024"
        height="438"
        loading="eager"
        decoding="async"
      />
      <!-- Subtle warm gradient: ensures text is purely readable over botanical shadows -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#F5ECDB]/65 via-[#F5ECDB]/35 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbs} class="mb-5 sm:mb-6" />
      <div class="max-w-3xl space-y-4">
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          Artistry in Every Detail
        </h1>
        <p class="text-base sm:text-lg text-[#5C4D3E] font-serif italic max-w-2xl leading-relaxed">
          Explore beauty, hair, nails and bridal ideas, then bring your favourite details into your consultation.
        </p>
      </div>
    </div>
  </section>
  <section class="editorial-section" aria-label="Image gallery">
    <div class="section-shell">
      <salon-gallery>
        <div class="gallery-filters" role="group" aria-label="Filter images">
          {filters.map(([value, label]) => <button type="button" data-filter={value} aria-pressed={value === 'all' ? 'true' : 'false'}>{label}</button>)}
        </div>
        <p class="gallery-count" data-gallery-count role="status" aria-live="polite">{galleryItems.length} images</p>
        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <a class="gallery-item" href={item.image} data-gallery-item data-category={item.categorySlug} data-title={item.title} data-description={item.alt} aria-label={`View ${item.title}`}>
              <figure>
                <div class="gallery-image"><img src={item.image} alt={item.alt} width="600" height="450" loading="lazy" decoding="async" /></div>
                <figcaption><span>{item.category}</span><h2>{item.title}</h2><span class="gallery-open" aria-hidden="true">↗</span></figcaption>
              </figure>
            </a>
          ))}
        </div>
        <p class="gallery-note">The two editorial still-life images are AI-generated inspiration, rather than photographs of salon products or customer results.</p>
        <dialog class="gallery-dialog" aria-labelledby="gallery-view-title">
          <div class="gallery-dialog-inner">
            <button type="button" data-gallery-close class="gallery-close" aria-label="Close image viewer">×</button>
            <img data-gallery-full alt="" width="1200" height="900" />
            <div class="gallery-view-caption"><h2 id="gallery-view-title"></h2><p data-gallery-caption></p></div>
            <div class="gallery-view-controls"><button type="button" data-gallery-prev aria-label="Previous image">← Previous</button><span data-gallery-position></span><button type="button" data-gallery-next aria-label="Next image">Next →</button></div>
          </div>
        </dialog>
      </salon-gallery>
    </div>
  </section>
  <JourneySection eyebrow="From inspiration to appointment" title="Find a Detail That Feels Like You" steps={[
    { title: 'Notice what you love', text: 'Look for a colour, shape, texture or finish that catches your eye. A small detail can be a helpful starting point.' },
    { title: 'Bring your references', text: 'Save a few images and share what you like about them, alongside your outfit or occasion if relevant.' },
    { title: 'Make it your own', text: 'Discuss how the direction could be adapted to your preferences. Reference images are inspiration, not a promise of an identical result.' },
  ]} tinted />
  <RelatedServices title="Take the Next Step from Inspiration" links={[
    { title: 'Hair artistry', href: '/hair-artistry-spa/' }, { title: 'Nail design', href: '/nail-studio/nail-addons/' },
    { title: 'Bridal looks', href: '/bridal/makeup-and-hair/' }, { title: 'Start a consultation', href: '/contact/#appointment' },
  ]} />
</BaseLayout>

<style>
  salon-gallery { display: block; }
  .gallery-filters { display: none; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  [data-ready] .gallery-filters { display: flex; }
  .gallery-filters button { min-height: 44px; padding: 10px 20px; border: 1px solid var(--color-gold-light); border-radius: 28px; font-size: 11px; color: var(--color-brown-deep); cursor: pointer; transition: background .25s; }
  .gallery-filters [aria-pressed='true'] { background: var(--color-brown-deep); color: var(--color-white); border-color: var(--color-brown-deep); }
  .gallery-count, .gallery-note { color: var(--color-text-muted); font-size: 11px; line-height: 1.8; margin-bottom: 24px; }
  .gallery-note { margin-top: 28px; max-width: 600px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
  .gallery-item { min-width: 0; }
  .gallery-item[hidden] { display: none; }
  .gallery-image { overflow: hidden; border-radius: 120px 120px 6px 6px; background: var(--color-bg-secondary); }
  .gallery-image img { aspect-ratio: 3 / 4; width: 100%; height: auto; object-fit: cover; transition: transform .5s; }
  .gallery-item:hover img { transform: scale(1.025); }
  figcaption { padding: 18px 28px 0 0; position: relative; }
  figcaption > span { font-size: 9px; text-transform: uppercase; letter-spacing: .15em; color: var(--color-gold-dark); }
  figcaption h2 { font-size: 22px; line-height: 1.2; margin-top: 8px; }
  figcaption .gallery-open { position: absolute; right: 0; top: 28px; font-size: 22px; }
  .gallery-dialog { margin: auto; width: min(94vw, 1040px); max-height: 94dvh; border: 0; padding: 0; color: var(--color-white); background: #28221c; border-radius: 12px; }
  .gallery-dialog::backdrop { background: rgb(40 34 28 / 85%); backdrop-filter: blur(6px); }
  .gallery-dialog-inner { padding: 52px 24px 24px; }
  .gallery-dialog img { width: 100%; height: min(64dvh, 700px); object-fit: contain; }
  .gallery-close { position: absolute; right: 12px; top: 6px; width: 44px; height: 44px; font-size: 32px; cursor: pointer; }
  .gallery-view-caption { margin-top: 18px; text-align: center; }
  .gallery-view-caption h2 { font-size: 26px; }
  .gallery-view-caption p { font-size: 12px; color: var(--color-gold-light); margin-top: 8px; }
  .gallery-view-controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; font-size: 12px; }
  .gallery-view-controls button { min-height: 44px; padding: 10px; cursor: pointer; }
  .gallery-view-controls button:disabled { opacity: .4; cursor: default; }
  .gallery-dialog :is(button):focus-visible { outline-color: var(--color-gold-light); }
  @media(max-width: 767px) { .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media(max-width: 479px) { .gallery-grid { grid-template-columns: 1fr; } }
  @media(prefers-reduced-motion: reduce) { .gallery-item:hover img { transform: none; } }
</style>
<script>
  import '../scripts/gallery';
</script>
