---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import BrochureCTA from '../components/BrochureCTA.astro';
import JourneySection from '../components/JourneySection.astro';
import FAQSection from '../components/FAQSection.astro';
import { servicesData } from '../data/services';
import { siteConfig } from '../data/site';

const seo = {
  title: "Salon Services & Treatment Menus | S For Swag Kochi",
  description: "Browse the complete salon service menu of S For Swag on MG Road, Kochi. Expert hair treatments, colouring, nail extensions, spa, facials, and bridal packages.",
  canonical: `${siteConfig.siteUrl}/services/`,
};

const breadcrumbs = [{ name: 'Services', url: '/services/' }];
---

<BaseLayout seo={seo}>
  <!-- Hero Banner -->
  <section class="page-hero-banner bg-[#F5ECDB] border-b border-[#eeda9b] relative overflow-hidden">
    <!-- Background Image Layer (Sunlit plaster with botanical shadows) -->
    <div class="absolute inset-0 pointer-events-none">
      <img
        src="/images/salon/page-hero-bg.webp"
        alt="S For Swag luxury salon ambiance"
        class="w-full h-full object-cover object-center"
        width="1024"
        height="438"
        loading="eager"
        decoding="async"
      />
      <!-- Subtle warm gradient: ensures text is purely readable over botanical shadows -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#F5ECDB]/65 via-[#F5ECDB]/35 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbs} class="mb-5 sm:mb-6" />
      <div class="max-w-3xl space-y-4">
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          Signature Services <br />
          <span class="font-normal">and Treatment Menus</span>
        </h1>
        <p class="text-base sm:text-lg text-[#5C4D3E] font-serif italic max-w-2xl leading-relaxed">
          "From everyday grooming to once in a lifetime bridal transformations."
        </p>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="py-20 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-20">
      
      {servicesData.map((category, index) => {
        const isReversed = index % 2 === 1;
        return (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
            
            <!-- Visual Card (Span 5) -->
            <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : ''}`}>
              <div class="relative overflow-hidden rounded-3xl border-2 border-[#FFFCF6] shadow-xl max-w-md mx-auto lg:max-w-none">
                <img
                  src={category.image}
                  alt={category.imageAlt}
                  class="block w-full h-auto object-contain"
                  width="800"
                  height="600"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#28221C]/40 via-transparent to-transparent"></div>
                <div class="absolute bottom-5 left-6 text-[#FFFCF6]">
                  <span class="text-[10px] uppercase tracking-[0.2em] font-semibold text-[#eeda9b] block">S For Swag</span>
                  <span class="text-xl font-serif font-bold">{category.title}</span>
                </div>
              </div>
            </div>

            <!-- Content Details (Span 7) -->
            <div class={`lg:col-span-7 space-y-6 ${isReversed ? 'lg:order-1' : ''}`}>
              <div class="space-y-2">
                <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#b7802c]">{category.tagline}</span>
                <h2 class="text-3xl sm:text-4xl font-serif text-[#28221C]">{category.title}</h2>
              </div>
              
              <p class="text-sm sm:text-base text-[#5C4D3E] leading-relaxed">
                {category.fullDesc}
              </p>

              <!-- Subcategories preview pills -->
              <div class="space-y-2">
                <span class="text-[11px] uppercase tracking-wider font-semibold text-[#8E7864] block">Key Offerings:</span>
                <div class="flex flex-wrap gap-2">
                  {category.subcategories.map((sub) => (
                    <a
                      href={`/${category.slug}/${sub.slug}/`}
                      class="text-xs bg-[#FFFCF6] hover:bg-[#b7802c] hover:text-[#FFFCF6] text-[#75451d] border border-[#eeda9b] px-3.5 py-1.5 rounded-full transition-all"
                    >
                      {sub.title} &rarr;
                    </a>
                  ))}
                </div>
              </div>

              <div class="pt-2 flex items-center gap-4">
                <a href={`/${category.slug}/`} class="luxury-pill-btn luxury-pill-gold">
                  <span>VIEW OUR SERVICES</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>

          </div>
        );
      })}

      <!-- Brochure Menu Notes Box -->
      <div class="p-8 rounded-3xl bg-[#F5ECDB]/80 border border-[#eeda9b] space-y-4">
        <h3 class="text-base uppercase tracking-widest font-bold text-[#75451d]">
          Salon Service Policy and Menu Notes
        </h3>
        <p class="text-xs text-[#5C4D3E] leading-relaxed">
          {siteConfig.pricingDisclaimer}
        </p>
      </div>

      <!-- Official Brochure Download CTA -->
      <BrochureCTA
        title="Download the Complete Salon Service Guide"
        eyebrow="Official Company Brochure"
        description="Explore our full collection of hair artistry, skin rituals, nail couture, wellness therapies, and bridal packages in a single convenient document."
      />

      <!-- Booking Form -->
      <div>
        <EnquiryForm />
      </div>

    </div>
  </section>
  <JourneySection title="A menu made easier to navigate." eyebrow="Choose with confidence" steps={[
    { title: 'Start with a category', text: 'Choose hair, beauty, nails, wellness or bridal, then open the relevant menu to compare individual services.' },
    { title: 'Keep your priorities in mind', text: 'Consider your occasion, preferred finish and available time. Save a few questions to discuss with the team.' },
    { title: 'Confirm your selection', text: 'Ask about inclusions, any additions and the treatment plan before confirming your appointment.' },
  ]} tinted />
  <FAQSection title="Understanding your service choices." items={[
    { question: 'How is service consultation conducted?', answer: siteConfig.pricingDisclaimer },
    { question: 'Can I book across different departments?', answer: 'Share all the services you are considering. Reception can confirm availability and help plan their sequence.' },
    { question: 'Where can I compare bridal packages?', answer: 'Open Bridal Studio from the directory above to compare Silver, Gold and Platinum packages and review their listed inclusions.' },
  ]} />
</BaseLayout>
