---
import { siteConfig, navLinks, serviceCategoryLinks } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#EFE2CE] text-[#28221C] border-t border-[#E8D5B7] pt-16 pb-12 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-[#D5C2A5]/50">
      
      <!-- Brand Column (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block" aria-label="S For Swag Home">
          <img src="/images/brand/logo.svg" alt="S For Swag The Salon Logo" class="h-12 w-auto" width="220" height="50" />
        </a>
        <p class="text-xs uppercase tracking-[0.2em] text-[#8E652E] font-semibold">
          Premium Unisex Salon by Seematti
        </p>
        <p class="text-sm text-[#5C4D3E] max-w-md leading-relaxed">
          Beauty is not about changing who you are. It is about bringing out what feels right for you. Complete luxury hair, skincare, nail couture, body wellness and bridal artistry in the heart of MG Road, Kochi.
        </p>

        <!-- Social Channels -->
        <div class="flex items-center gap-4 pt-2">
          <a
            href={siteConfig.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-[#A77A3F]/50 flex items-center justify-center text-[#4A321C] hover:bg-[#A77A3F] hover:text-[#FFFCF6] hover:border-[#A77A3F] transition-all"
            aria-label="Follow S For Swag on Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28-.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href={siteConfig.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-[#A77A3F]/50 flex items-center justify-center text-[#4A321C] hover:bg-[#A77A3F] hover:text-[#FFFCF6] hover:border-[#A77A3F] transition-all"
            aria-label="Enquire via WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h3 class="text-xs uppercase tracking-[0.2em] font-semibold text-[#4A321C]">Explore</h3>
        <ul class="space-y-2 text-sm">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-[#5C4D3E] hover:text-[#A77A3F] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/privacy-policy/" class="text-[#5C4D3E] hover:text-[#A77A3F] transition-colors">
              Privacy Policy
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Categories -->
      <div class="space-y-3">
        <h3 class="text-xs uppercase tracking-[0.2em] font-semibold text-[#4A321C]">Services</h3>
        <ul class="space-y-2 text-sm">
          {serviceCategoryLinks.map((item) => (
            <li>
              <a href={item.href} class="text-[#5C4D3E] hover:text-[#A77A3F] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Visit Us / Contact -->
      <div class="space-y-3">
        <h3 class="text-xs uppercase tracking-[0.2em] font-semibold text-[#4A321C]">Salon Studio</h3>
        <address class="not-italic text-sm text-[#5C4D3E] space-y-2">
          <p class="leading-relaxed">
            {siteConfig.address.floor}, {siteConfig.address.building}<br />
            {siteConfig.address.street}<br />
            {siteConfig.address.landmark}<br />
            {siteConfig.address.city}, {siteConfig.address.state} – {siteConfig.address.pincode}
          </p>
          <div class="pt-1">
            <a
              href={siteConfig.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#A77A3F] hover:text-[#8E652E]"
            >
              <span>Get Directions on Google Maps</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
          <p class="pt-2 text-xs">
            <span class="font-medium text-[#4A321C]">Phone:</span>{' '}
            <a href={`tel:${siteConfig.phone}`} class="hover:text-[#A77A3F]">{siteConfig.phoneFormatted}</a>
          </p>
          <p class="text-xs">
            <span class="font-medium text-[#4A321C]">Email:</span>{' '}
            <a href={`mailto:${siteConfig.email}`} class="hover:text-[#A77A3F]">{siteConfig.email}</a>
          </p>
        </address>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#8E7864] gap-4">
      <p>
        © {currentYear} {siteConfig.legalName}. All rights reserved.
      </p>
      <p class="text-center sm:text-right">
        {siteConfig.tagline} • Kochi, Kerala
      </p>
    </div>
  </div>
</footer>
