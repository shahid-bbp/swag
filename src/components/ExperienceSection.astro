---
---

<section class="py-20 lg:py-24 bg-[#F5ECDB]/60 border-t border-b border-[#eeda9b] relative overflow-hidden">
  
  <!-- Subtle fluid wave contour in background -->
  <div class="absolute inset-0 opacity-40 pointer-events-none bg-[radial-gradient(#C5A059_0.75px,transparent_0.75px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Heading (Span 5) -->
      <div class="lg:col-span-5 space-y-3">
        <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#75451d] font-semibold">
          The S For Swag Experience
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[#28221C] leading-[1.12]">
          Personalised Care. <br />
          <span class="italic font-normal">Premium Experience.</span>
        </h2>
        <p class="text-sm text-[#5C4D3E] max-w-md leading-relaxed pt-1">
          Every appointment is tailored to your individual style, hair texture, skin tone, and personal comfort.
        </p>
      </div>

      <!-- Right: 3 Steps Horizontal Workflow (Span 7) -->
      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4 relative items-start">
          
          <!-- Step 1: Consultation -->
          <div class="flex flex-col items-center text-center space-y-3 relative group">
            <div class="w-16 h-16 rounded-full border border-[#b7802c] bg-[#FFFCF6] flex items-center justify-center text-[#b7802c] shadow-xs group-hover:scale-105 group-hover:bg-[#b7802c] group-hover:text-[#FFFCF6] transition-all">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="text-[0.6875rem] uppercase tracking-[0.2em] font-semibold text-[#75451d]">
              1. Consultation
            </span>
            <p class="text-xs text-[#6C5D4F] leading-relaxed max-w-[200px]">
              Understanding you, your personal goals and lifestyle before we begin.
            </p>
          </div>

          <!-- Step 2: Personalisation -->
          <div class="flex flex-col items-center text-center space-y-3 relative group">
            <div class="w-16 h-16 rounded-full border border-[#b7802c] bg-[#FFFCF6] flex items-center justify-center text-[#b7802c] shadow-xs group-hover:scale-105 group-hover:bg-[#b7802c] group-hover:text-[#FFFCF6] transition-all">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11z"></path>
                <path d="M12 12c-2 2-2 4-2 4s2 0 4-2"></path>
              </svg>
            </div>
            <span class="text-[0.6875rem] uppercase tracking-[0.2em] font-semibold text-[#75451d]">
              2. Personalisation
            </span>
            <p class="text-xs text-[#6C5D4F] leading-relaxed max-w-[200px]">
              Custom formulations and treatments tailored precisely to your needs.
            </p>
          </div>

          <!-- Step 3: Experience -->
          <div class="flex flex-col items-center text-center space-y-3 relative group">
            <div class="w-16 h-16 rounded-full border border-[#b7802c] bg-[#FFFCF6] flex items-center justify-center text-[#b7802c] shadow-xs group-hover:scale-105 group-hover:bg-[#b7802c] group-hover:text-[#FFFCF6] transition-all">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
            </div>
            <span class="text-[0.6875rem] uppercase tracking-[0.2em] font-semibold text-[#75451d]">
              3. Experience
            </span>
            <p class="text-xs text-[#6C5D4F] leading-relaxed max-w-[200px]">
              A seamless, restorative journey from your warm arrival to the final finish.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
