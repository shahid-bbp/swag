---
import { navLinks, siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 w-full z-50 py-2 sm:py-3 px-6 sm:px-10 lg:px-12">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-3 transition-transform hover:opacity-95 pl-2 sm:pl-4 lg:pl-6" aria-label="S For Swag Home">
      <img src="/images/brand/logo.png" alt="S For Swag The Salon Logo" class="h-16 sm:h-20 object-contain" width="160" height="186" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-[0.875rem] uppercase tracking-[0.16em] font-medium transition-colors relative py-1 ${
              isActive ? 'text-[#b7802c] font-semibold' : 'text-[#75451d] hover:text-[#b7802c]'
            }`}
          >
            {link.label}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#b7802c]" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="/contact/#appointment"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-[#b7802c] text-[#75451d] bg-[#FFFCF6]/80 hover:bg-[#b7802c] hover:text-[#FFFCF6] text-[0.8125rem] tracking-[0.14em] uppercase font-medium transition-all duration-300 shadow-xs"
      >
        <span>Book Appointment</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <noscript><nav class="lg:hidden flex gap-4 text-xs" aria-label="Mobile navigation"><a href="/services/">Services</a><a href="/contact/">Contact</a></nav><style is:inline>#mobile-menu-btn { display: none; }</style></noscript>
    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center text-[#75451d] hover:text-[#b7802c] focus:outline-none focus:ring-2 focus:ring-[#b7802c] rounded-lg"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden fixed top-[var(--site-header-height)] left-0 w-full h-[calc(100dvh-var(--site-header-height))] bg-[#F7F0E4] border-t border-[#eeda9b] px-6 py-8 flex flex-col justify-between overflow-y-auto"
  >
    <div class="flex flex-col gap-6">
      <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#8E7864] font-semibold">Navigation</span>
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-xl font-serif py-1 transition-colors ${
              isActive ? 'text-[#b7802c] font-bold' : 'text-[#28221C] hover:text-[#b7802c]'
            }`}
          >
            {link.label}
          </a>
        );
      })}

      <div class="pt-4 border-t border-[#eeda9b]/80 flex flex-col gap-3">
        <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#8E7864] font-semibold">Services</span>
        <a href="/beauty-lounge/" class="text-sm text-[#75451d] hover:text-[#b7802c]">Beauty Lounge</a>
        <a href="/nail-studio/" class="text-sm text-[#75451d] hover:text-[#b7802c]">Nail Studio</a>
        <a href="/hair-artistry-spa/" class="text-sm text-[#75451d] hover:text-[#b7802c]">Hair Artistry & Spa</a>
        <a href="/body-wellness-spa/" class="text-sm text-[#75451d] hover:text-[#b7802c]">Body Wellness Spa</a>
        <a href="/bridal/" class="text-sm text-[#75451d] hover:text-[#b7802c]">Bridal Studio & Packages</a>
      </div>
    </div>

    <div class="pt-8 border-t border-[#eeda9b] flex flex-col gap-4">
      <a
        href="/contact/#appointment"
        class="w-full text-center py-3 rounded-full bg-[#b7802c] text-[#FFFCF6] text-xs uppercase tracking-[0.16em] font-medium shadow-sm hover:bg-[#75451d] transition-colors"
      >
        Book Appointment
      </a>
      <div class="flex items-center justify-between text-xs text-[#6C5D4F] pt-2">
        <a href={`tel:${siteConfig.phone}`} class="hover:text-[#b7802c]">{siteConfig.phoneFormatted}</a>
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#b7802c] font-medium">WhatsApp Us</a>
      </div>
    </div>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent !important;
    background-image: none !important;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition:
      border-color 400ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 400ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 400ms cubic-bezier(0.16, 1, 0.3, 1),
      -webkit-backdrop-filter 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* GPU-accelerated gradient layer for buttery smooth fade-in */
  #site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      135deg,
      rgba(248, 240, 227, 0.95) 0%,
      rgba(234, 214, 184, 0.88) 50%,
      rgba(246, 232, 212, 0.96) 100%
    );
    opacity: 0;
    transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  /* Scrolled header state */
  #site-header.header--scrolled {
    border-bottom-color: rgba(238, 218, 155, 0.6);
    box-shadow: 0 4px 20px -2px rgba(117, 69, 29, 0.07), 0 2px 6px -1px rgba(183, 128, 44, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #site-header.header--scrolled::before {
    opacity: 1;
  }

  /* Opened mobile drawer state ensures consistent solid surface */
  #site-header.header--menu-open {
    border-bottom-color: rgba(238, 218, 155, 0.6);
    background-color: #F7F0E4;
  }

  #site-header.header--menu-open::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header::before {
      transition: none !important;
    }
  }
</style>

<script>
  import '../scripts/site-header';
</script>
