---
import { bridalPackagesData, bridalTimeline } from '../data/bridal-packages';
import { siteConfig } from '../data/site';

const featureRows = bridalPackagesData[0].features.map((f) => f.label);
---

<div class="space-y-16">
  
  <!-- Packages Pricing Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
    {bridalPackagesData.map((pkg) => (
      <div
        class={`bg-[#FFFCF6] rounded-3xl p-8 flex flex-col justify-between border transition-all duration-300 relative ${
          pkg.isPopular
            ? 'border-[#A77A3F] shadow-xl ring-2 ring-[#A77A3F]/20 -translate-y-2'
            : 'border-[#E8D5B7] shadow-sm hover:border-[#A77A3F]'
        }`}
      >
        {pkg.badge && (
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#A77A3F] text-[#FFFCF6] text-[10px] uppercase tracking-[0.2em] font-semibold px-4 py-1 rounded-full shadow-xs">
            {pkg.badge}
          </div>
        )}

        <div class="space-y-6">
          <div class="border-b border-[#E8D5B7] pb-6 text-center">
            <h3 class="text-2xl font-serif text-[#28221C]">{pkg.name}</h3>
            <p class="text-xs text-[#6C5D4F] mt-1 min-h-[32px]">{pkg.tagline}</p>
            <div class="mt-4">
              <span class="text-3xl sm:text-4xl font-serif font-bold text-[#A77A3F]">
                {pkg.price}
              </span>
              <span class="text-[11px] text-[#8E7864] block mt-0.5">starting price &bull; customized after consultation</span>
            </div>
          </div>

          <!-- Feature items list for card view -->
          <ul class="space-y-3 text-xs text-[#4A321C]">
            {pkg.features.map((feat) => (
              <li class="flex items-start justify-between gap-2 py-1 border-b border-[#F7F0E4]">
                <span class="text-[#5C4D3E]">{feat.label}</span>
                <span class={`font-semibold shrink-0 ${feat.included ? 'text-[#8E652E]' : 'text-[#A39485]'}`}>
                  {feat.value}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-8">
          <a
            href="#book-appointment"
            class={`w-full text-center py-3 rounded-full text-xs uppercase tracking-[0.16em] font-semibold transition-all block ${
              pkg.isPopular
                ? 'bg-[#A77A3F] hover:bg-[#8E652E] text-[#FFFCF6] shadow-sm'
                : 'border border-[#A77A3F] text-[#4A321C] hover:bg-[#A77A3F] hover:text-[#FFFCF6]'
            }`}
          >
            Choose {pkg.name}
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Detailed Comparison Table (Desktop View) -->
  <div class="hidden lg:block bg-[#FFFCF6] rounded-3xl border border-[#E8D5B7] overflow-hidden shadow-sm">
    <div class="p-6 bg-[#EFE2CE]/60 border-b border-[#E8D5B7]">
      <h3 class="text-xl font-serif text-[#28221C]">Complete Package Inclusions Matrix</h3>
      <p class="text-xs text-[#6C5D4F]">As verified in the official S For Swag Salon Bridal Menu.</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-[#F7F0E4] border-b border-[#E8D5B7] text-[#4A321C] uppercase tracking-wider font-semibold">
            <th class="p-4 pl-6">Inclusions</th>
            <th class="p-4 text-center">Silver (₹25,999)</th>
            <th class="p-4 text-center bg-[#EFE2CE]/50 text-[#8E652E]">Gold (₹45,999)</th>
            <th class="p-4 text-center pr-6">Platinum (₹65,999)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E8D5B7]/50 text-[#5C4D3E]">
          {featureRows.map((label) => {
            const silver = bridalPackagesData[0].features.find((f) => f.label === label);
            const gold = bridalPackagesData[1].features.find((f) => f.label === label);
            const platinum = bridalPackagesData[2].features.find((f) => f.label === label);
            return (
              <tr class="hover:bg-[#F7F0E4]/40 transition-colors">
                <td class="p-4 pl-6 font-medium text-[#28221C]">{label}</td>
                <td class="p-4 text-center">
                  {silver?.value === 'Included' ? (
                    <span class="text-[#A77A3F] font-bold">✓</span>
                  ) : (
                    silver?.value
                  )}
                </td>
                <td class="p-4 text-center bg-[#EFE2CE]/30 font-semibold text-[#8E652E]">
                  {gold?.value === 'Included' ? (
                    <span class="text-[#A77A3F] font-bold">✓</span>
                  ) : (
                    gold?.value
                  )}
                </td>
                <td class="p-4 text-center pr-6 font-semibold text-[#28221C]">
                  {platinum?.value === 'Included' ? (
                    <span class="text-[#A77A3F] font-bold">✓</span>
                  ) : (
                    platinum?.value
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pre-Bridal Preparation Timeline (Brochure Page 11) -->
  <div class="bg-[#FFFCF6] rounded-3xl border border-[#E8D5B7] p-8 sm:p-12 shadow-sm">
    <div class="max-w-xl mb-10">
      <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#8E652E] font-semibold">Pre-Bridal Journey</span>
      <h3 class="text-3xl font-serif text-[#28221C] mt-1">Recommended Bridal Preparation Guide</h3>
      <p class="text-xs text-[#6C5D4F] mt-2 leading-relaxed">
        To achieve maximum wedding day glow and harmony, our senior artists recommend beginning your bridal care rituals 4–6 weeks prior.
      </p>
    </div>

    <div class="relative border-l-2 border-[#A77A3F]/40 ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-8">
      {bridalTimeline.map((step) => (
        <div class="relative group">
          <!-- Marker Circle -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-0 w-4 h-4 rounded-full bg-[#FFFCF6] border-2 border-[#A77A3F] group-hover:bg-[#A77A3F] transition-colors"></div>
          
          <div class="bg-[#F7F0E4]/60 p-5 rounded-2xl border border-[#E8D5B7] hover:border-[#A77A3F] transition-all">
            <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-[#A77A3F] block mb-1">
              {step.timeline}
            </span>
            <h4 class="text-base font-serif font-semibold text-[#28221C] mb-1">
              {step.title}
            </h4>
            <p class="text-xs text-[#5C4D3E] leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

</div>
