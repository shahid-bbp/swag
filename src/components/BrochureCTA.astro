---
import { siteConfig } from '../data/site';

export interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  compact?: boolean;
  class?: string;
}

const {
  title = "Download Our Official Salon Brochure",
  eyebrow = "Complete Menu & Experience Guide",
  description = "Explore our complete menu of hair artistry, skin rituals, nail couture, body wellness, and bespoke bridal packages in one comprehensive guide.",
  compact = false,
  class: className = "",
} = Astro.props;
---

<div class={`relative overflow-hidden rounded-3xl border border-[#eeda9b] bg-gradient-to-br from-[#FFFDF9] via-[#FBF5EA] to-[#F5ECDB] p-8 sm:p-12 shadow-sm ${className}`}>
  <!-- Decorative subtle background watermarks -->
  <div class="absolute -right-12 -bottom-12 w-64 h-64 rounded-full bg-[#b7802c]/5 blur-3xl pointer-events-none"></div>
  <div class="absolute top-0 right-0 translate-x-4 -translate-y-4 w-32 h-32 opacity-10 pointer-events-none">
    <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-[#75451d]">
      <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" />
      <path d="M50 20 L50 80 M20 50 L80 50" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </div>

  <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
    <!-- Left Column: Details -->
    <div class="space-y-4 max-w-2xl">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1 rounded-full bg-[#F5ECDB] border border-[#eeda9b] text-[11px] uppercase tracking-[0.2em] font-semibold text-[#75451d]">
        <svg class="w-3.5 h-3.5 text-[#b7802c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>{eyebrow}</span>
      </div>

      <h3 class="text-2xl sm:text-4xl font-serif text-[#28221C] leading-tight">
        {title}
      </h3>

      <p class="text-xs sm:text-sm text-[#5C4D3E] leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-1 text-xs text-[#8E7864]">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#b7802c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Full 12-Page Official Brochure (PDF)
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#b7802c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Includes Bridal Countdown & Service Notes
        </span>
      </div>
    </div>

    <!-- Right Column: Action Buttons -->
    <div class="flex flex-col sm:flex-row lg:flex-col gap-3.5 w-full sm:w-auto shrink-0">
      <!-- Download PDF Button / Modal Trigger -->
      <button
        type="button"
        data-open-brochure-modal
        class="inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-[#b7802c] hover:bg-[#75451d] text-[#FFFCF6] font-semibold text-xs uppercase tracking-[0.16em] shadow-md hover:shadow-lg transition-all text-center group cursor-pointer"
      >
        <svg class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>View & Download Brochure</span>
      </button>

      <!-- WhatsApp Concierge Button -->
      <a
        href={siteConfig.whatsappBrochureUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full bg-[#FFFCF6] hover:bg-[#25D366] text-[#28221C] hover:text-[#FFFCF6] border border-[#eeda9b] hover:border-[#25D366] font-semibold text-xs uppercase tracking-[0.16em] transition-all text-center shadow-xs"
      >
        <svg class="w-4 h-4 text-[#25D366] group-hover:text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Request via WhatsApp</span>
      </a>
    </div>
  </div>
</div>
