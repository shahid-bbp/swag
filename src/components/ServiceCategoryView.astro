---
import Breadcrumbs from './Breadcrumbs.astro';
import EnquiryForm from './EnquiryForm.astro';
import ServiceGuides from './ServiceGuides.astro';
import { siteConfig } from '../data/site';
import type { ServiceCategory } from '../data/services';

export interface Props {
  category: ServiceCategory;
  activeSubcategorySlug?: string;
}

const { category, activeSubcategorySlug } = Astro.props;

const breadcrumbs = [
  { name: 'Services', url: '/services/' },
  { name: category.title, url: `/${category.slug}/` },
];

if (activeSubcategorySlug) {
  const activeSub = category.subcategories.find((s) => s.slug === activeSubcategorySlug);
  if (activeSub) {
    breadcrumbs.push({
      name: activeSub.title,
      url: `/${category.slug}/${activeSub.slug}/`,
    });
  }
}

const displaySubcategories = activeSubcategorySlug
  ? category.subcategories.filter((s) => s.slug === activeSubcategorySlug)
  : category.subcategories;
const activeSubcategory = category.subcategories.find((sub) => sub.slug === activeSubcategorySlug);
const heroImage = activeSubcategory?.image || category.image;
const heroImageAlt = activeSubcategory?.imageAlt || category.imageAlt || category.title;

const getWhatsAppServiceUrl = (serviceName: string) => {
  const text = `Hello S For Swag, I would like to enquire about ${serviceName}.`;
  return `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(text)}`;
};
---

<div>
  <!-- Hero Header (Editorial Split Layout) -->
  <section class="page-hero-banner relative bg-[#F5ECDB] border-b border-[#eeda9b] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <Breadcrumbs items={breadcrumbs} class="mb-5 sm:mb-6" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Category Narrative (Span 7) -->
        <div class="lg:col-span-7 space-y-4">
          <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
            {activeSubcategory?.title || category.title}
          </h1>
          <p class="text-xl sm:text-2xl font-serif italic text-[#75451d]">
            {category.tagline}
          </p>
          <p class="text-sm sm:text-base text-[#5C4D3E] leading-relaxed max-w-2xl pt-1">
            {activeSubcategory?.description || category.fullDesc}
          </p>
        </div>

        <!-- Right: Crisp Luxury Editorial Image Card (Span 5) -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border-2 border-[#FFFCF6] shadow-xl group max-w-md mx-auto lg:max-w-none">
            <img
              src={heroImage}
              alt={heroImageAlt}
              class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700"
              width="800"
              height="600"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#28221C]/40 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-5 text-[#FFFCF6]">
              <span class="text-[10px] uppercase tracking-[0.2em] font-semibold text-[#eeda9b] block">Signature Care</span>
              <span class="text-lg font-serif font-medium">{activeSubcategory?.title || category.title}</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Sticky Subcategory Tabs Navigation Bar (Concept 1) -->
  <nav
    aria-label="Subcategory Navigation"
    class="sticky top-[var(--site-header-height)] z-30 bg-[#F5ECDB]/95 backdrop-blur-md border-b border-[#eeda9b] shadow-xs"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3">
      <div class="flex items-center gap-2.5 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-0.5">
        <a
          href={`/${category.slug}/`}
          class={`shrink-0 px-4 py-2 rounded-full text-xs uppercase tracking-wider font-semibold transition-all ${
            !activeSubcategorySlug
              ? 'bg-[#b7802c] text-[#FFFCF6] shadow-sm'
              : 'bg-[#FFFCF6] text-[#75451d] border border-[#eeda9b] hover:border-[#b7802c]'
          }`}
        >
          All {category.title}
        </a>
        {category.subcategories.map((sub) => {
          const isCurrent = activeSubcategorySlug === sub.slug;
          return (
            <a
              href={`/${category.slug}/${sub.slug}/`}
              class={`shrink-0 px-4 py-2 rounded-full text-xs uppercase tracking-wider font-semibold transition-all ${
                isCurrent
                  ? 'bg-[#b7802c] text-[#FFFCF6] shadow-sm'
                  : 'bg-[#FFFCF6] text-[#75451d] border border-[#eeda9b] hover:border-[#b7802c]'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>
  </nav>

  <!-- Service Subcategories & Price Menus (Concept 1 Luxury Atelier Grid) -->
  <section class="py-16 sm:py-20 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-20">
      
      {displaySubcategories.map((subcat) => (
        <div class="space-y-8" id={subcat.slug}>
          <!-- Subcategory Atelier Header -->
          <div class="border-b border-[#eeda9b] pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div class="space-y-2 max-w-2xl">
              <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.24em] font-semibold text-[#b7802c]">
                <span>S For Swag</span>
                <span class="w-1 h-1 rounded-full bg-[#b7802c]"></span>
                <span>Atelier Treatment Menu</span>
              </div>
              <h2 class="text-3xl sm:text-4xl font-serif text-[#28221C]">
                {subcat.title}
              </h2>
              <p class="text-xs sm:text-sm text-[#6C5D4F] leading-relaxed font-serif italic pt-0.5">
                "{subcat.description}"
              </p>
            </div>

            <!-- Service Count Badge -->
            <div class="shrink-0">
              <span class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#FFFCF6] border border-[#eeda9b] text-xs font-semibold text-[#75451d] shadow-2xs">
                <span>{subcat.items.length} Curated Services</span>
              </span>
            </div>
          </div>

          <!-- Concept 1 Luxury Atelier Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7 items-stretch">
            {subcat.items.map((item) => (
              <div class="bg-gradient-to-b from-[#FFFDF9] via-[#FAF4E8] to-[#FFFDF9] border border-[#eeda9b] rounded-3xl p-6 sm:p-7 flex flex-col justify-between hover:border-[#b7802c] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative">
                
                <div class="space-y-3.5">
                  <!-- Card Header: Title -->
                  <div>
                    <h3 class="text-base sm:text-lg font-serif font-semibold text-[#28221C] group-hover:text-[#75451d] transition-colors leading-snug">
                      {item.name}
                    </h3>
                  </div>

                  <!-- Treatment Description -->
                  <p class="text-xs text-[#5C4D3E] leading-relaxed">
                    {item.description}
                  </p>

                  <!-- Duration & Gender Pill Badges -->
                  <div class="flex flex-wrap items-center gap-2 pt-1 text-[11px] text-[#8E7864]">
                    {item.duration && (
                      <span class="inline-flex items-center gap-1.5 bg-[#FFFCF6] border border-[#eeda9b]/80 px-2.5 py-1 rounded-full text-[11px] font-medium text-[#75451d]">
                        <svg class="w-3 h-3 text-[#b7802c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{item.duration}</span>
                      </span>
                    )}
                    {item.gender && (
                      <span class="inline-flex items-center bg-[#FFFCF6] border border-[#eeda9b]/80 px-2.5 py-1 rounded-full text-[11px] font-medium text-[#75451d] capitalize">
                        {item.gender}
                      </span>
                    )}
                  </div>
                </div>

                <!-- Footer Action Bar -->
                <div class="pt-4 mt-5 border-t border-[#eeda9b]/60 flex items-center justify-between gap-3">
                  <!-- Book Treatment Button -->
                  <a
                    href="#book-appointment"
                    data-service-select={item.name}
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#b7802c] hover:bg-[#75451d] text-[#FFFCF6] text-xs font-semibold uppercase tracking-wider transition-all shadow-xs group-hover:shadow-sm"
                  >
                    <span>Book Service</span>
                    <span class="text-[11px]">&rarr;</span>
                  </a>

                  <!-- Quick WhatsApp Enquiry with pre-filled message -->
                  <a
                    href={getWhatsAppServiceUrl(item.name)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full bg-[#FFFCF6] hover:bg-[#25D366] text-[#75451d] hover:text-[#FFFCF6] border border-[#eeda9b] hover:border-[#25D366] text-xs font-medium transition-all shadow-2xs"
                    title={`Enquire about ${item.name} on WhatsApp`}
                  >
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                    <span class="hidden sm:inline text-[11px] font-semibold uppercase tracking-wider">WhatsApp</span>
                  </a>
                </div>

              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Official Brochure Menu Notes Box (Section 6 requirement) -->
      <div class="p-6 sm:p-8 rounded-2xl bg-[#F5ECDB]/70 border border-[#eeda9b] space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#b7802c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <h3 class="text-sm uppercase tracking-[0.16em] font-bold text-[#75451d]">
            Official Salon Menu Notes & Service Policy
          </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-[#5C4D3E] leading-relaxed">
          <ul class="space-y-2 list-disc list-inside">
            <li>All services are tailored to individual requirements, hair length, texture, and service complexity.</li>
            <li>Consultations are conducted prior to your service to confirm treatment options and personalized care.</li>
            <li>Appointments are recommended to ensure dedicated time with your specialist.</li>
          </ul>
          <ul class="space-y-2 list-disc list-inside">
            <li>Bridal packages are customized after consultation and are subject to artist availability.</li>
            <li>Makeup, hairstyle, saree draping and accessories are curated according to the bride's looks and events.</li>
            <li>On-location bridal services available outside city limits upon prior request.</li>
          </ul>
        </div>
      </div>

    </div>
  </section>
  <ServiceGuides {category} activeSlug={activeSubcategorySlug} />
  <section class="editorial-section editorial-section--tinted" aria-label="Appointment enquiry"><div class="section-shell">
      <!-- Booking Section -->
      <div id="book-appointment" class="pt-8">
        <EnquiryForm
          preselectedService={category.title}
          title={`Enquire for ${category.title}`}
          subtitle="Select your preferred schedule and stylist. Our concierge team will reach out with confirmation."
        />
      </div>


  </div></section>
</div>

<script>
  function setupServiceSelection() {
    const bookButtons = document.querySelectorAll<HTMLElement>('[data-service-select]');
    const selectEl = document.getElementById('client-service') as HTMLSelectElement | null;

    bookButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const serviceName = btn.getAttribute('data-service-select');
        if (!serviceName || !selectEl) return;

        let matched = Array.from(selectEl.options).find(
          (opt) =>
            opt.text.toLowerCase().includes(serviceName.toLowerCase()) ||
            opt.value.toLowerCase().includes(serviceName.toLowerCase())
        );

        if (matched) {
          matched.selected = true;
        } else {
          const newOption = new Option(serviceName, serviceName, true, true);
          selectEl.add(newOption, 1);
        }
      });
    });
  }

  setupServiceSelection();
  document.addEventListener('astro:page-load', setupServiceSelection);
</script>
