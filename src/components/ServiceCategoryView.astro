---
import Breadcrumbs from './Breadcrumbs.astro';
import EnquiryForm from './EnquiryForm.astro';
import { siteConfig } from '../data/site';
import type { ServiceCategory } from '../data/services';

export interface Props {
  category: ServiceCategory;
  activeSubcategorySlug?: string;
}

const { category, activeSubcategorySlug } = Astro.props;

const breadcrumbs = [
  { name: 'Services', url: '/services/' },
  { name: category.title, url: `/${category.slug}/` },
];

if (activeSubcategorySlug) {
  const activeSub = category.subcategories.find((s) => s.slug === activeSubcategorySlug);
  if (activeSub) {
    breadcrumbs.push({
      name: activeSub.title,
      url: `/${category.slug}/${activeSub.slug}/`,
    });
  }
}

const displaySubcategories = activeSubcategorySlug
  ? category.subcategories.filter((s) => s.slug === activeSubcategorySlug)
  : category.subcategories;
---

<div>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Header -->
  <section class="relative py-16 sm:py-24 bg-[#EFE2CE] border-b border-[#E8D5B7] overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none">
      <img src={category.image} alt="" class="w-full h-full object-cover filter blur-xs" />
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-[0.24em] text-[#8E652E] font-semibold">S For Swag &bull; Kochi</span>
          <span class="w-12 h-[1px] bg-[#A77A3F]"></span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-serif text-[#28221C] leading-[1.1]">
          {category.title}
        </h1>
        <p class="text-xl sm:text-2xl font-serif italic text-[#8E652E]">
          {category.tagline}
        </p>
        <p class="text-sm sm:text-base text-[#5C4D3E] leading-relaxed max-w-2xl pt-2">
          {category.fullDesc}
        </p>
      </div>

      <!-- Subcategory Tabs Navigation -->
      <div class="pt-8 flex flex-wrap gap-2.5">
        <a
          href={`/${category.slug}/`}
          class={`px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all ${
            !activeSubcategorySlug
              ? 'bg-[#A77A3F] text-[#FFFCF6] shadow-sm'
              : 'bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F]'
          }`}
        >
          All {category.title}
        </a>
        {category.subcategories.map((sub) => {
          const isCurrent = activeSubcategorySlug === sub.slug;
          return (
            <a
              href={`/${category.slug}/${sub.slug}/`}
              class={`px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all ${
                isCurrent
                  ? 'bg-[#A77A3F] text-[#FFFCF6] shadow-sm'
                  : 'bg-[#FFFCF6] text-[#4A321C] border border-[#E8D5B7] hover:border-[#A77A3F]'
              }`}
            >
              {sub.title}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Service Subcategories & Price Menus -->
  <section class="py-16 sm:py-20 bg-[#F7F0E4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-16">
      
      {displaySubcategories.map((subcat) => (
        <div class="space-y-6">
          <div class="border-b border-[#E8D5B7] pb-4">
            <h2 class="text-2xl sm:text-3xl font-serif text-[#28221C]">
              {subcat.title}
            </h2>
            <p class="text-sm text-[#6C5D4F] mt-1 max-w-2xl">
              {subcat.description}
            </p>
          </div>

          <!-- Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {subcat.items.map((item) => (
              <div class="bg-[#FFFCF6] border border-[#E8D5B7] rounded-2xl p-6 flex flex-col justify-between hover:border-[#A77A3F] hover:shadow-md transition-all group">
                <div class="space-y-3">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-lg font-serif text-[#28221C] group-hover:text-[#8E652E] transition-colors leading-snug">
                      {item.name}
                    </h3>
                    <span class="text-base font-serif font-bold text-[#A77A3F] shrink-0">
                      {item.price}
                    </span>
                  </div>

                  <p class="text-xs text-[#6C5D4F] leading-relaxed">
                    {item.description}
                  </p>

                  <div class="flex flex-wrap items-center gap-2 pt-1 text-[11px] text-[#8E7864]">
                    {item.duration && (
                      <span class="inline-flex items-center gap-1 bg-[#F7F0E4] px-2.5 py-1 rounded-md">
                        <svg class="w-3 h-3 text-[#A77A3F]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{item.duration}</span>
                      </span>
                    )}
                    {item.gender && (
                      <span class="bg-[#F7F0E4] px-2.5 py-1 rounded-md capitalize font-medium">
                        {item.gender}
                      </span>
                    )}
                    {item.isPlusPlus && (
                      <span class="text-[10px] text-[#8E652E] bg-[#EFE2CE] px-2 py-0.5 rounded">
                        Starting Price ++
                      </span>
                    )}
                  </div>
                </div>

                <div class="pt-5 mt-4 border-t border-[#F7F0E4] flex items-center justify-between">
                  <a
                    href="#book-appointment"
                    class="text-[11px] uppercase tracking-wider font-semibold text-[#8E652E] hover:text-[#4A321C] transition-colors"
                  >
                    Select Service &rarr;
                  </a>
                  <a
                    href={siteConfig.whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-[#25D366] hover:underline"
                    title="Quick query on WhatsApp"
                  >
                    Quick Ask
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Official Brochure Menu Notes Box (Section 6 requirement) -->
      <div class="p-6 sm:p-8 rounded-2xl bg-[#EFE2CE]/70 border border-[#E8D5B7] space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#A77A3F]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <h3 class="text-sm uppercase tracking-[0.16em] font-bold text-[#4A321C]">
            Official Salon Menu Notes & Pricing Policy
          </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-[#5C4D3E] leading-relaxed">
          <ul class="space-y-2 list-disc list-inside">
            <li>All prices are in Indian Rupees (₹).</li>
            <li>All prices mentioned are starting prices and may vary based on individual requirements, hair length, density, and service complexity.</li>
            <li>Final pricing will be confirmed prior to the service.</li>
          </ul>
          <ul class="space-y-2 list-disc list-inside">
            <li>Bridal packages are customised after consultation and are subject to appointment availability.</li>
            <li>Makeup, hairstyle, saree draping and accessories can be customised according to the bride's look and functions.</li>
            <li>Travel expenses will be additional for locations outside city limits. GST, if applicable, may be charged separately.</li>
          </ul>
        </div>
      </div>

      <!-- Booking Section -->
      <div id="book-appointment" class="pt-8">
        <EnquiryForm
          preselectedService={category.title}
          title={`Enquire for ${category.title}`}
          subtitle="Select your preferred schedule and stylist. Our concierge team will reach out with confirmation."
        />
      </div>

    </div>
  </section>
</div>
