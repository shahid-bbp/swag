---
import { siteConfig } from '../data/site';

interface SlideData {
  id: string;
  number: string;
  bgImage: string;
  eyebrowLine1: string;
  eyebrowLine2: string;
  title1: string;
  title2: string;
  titleBold: string;
  italicSub: string;
  description: string;
  ctaText: string;
  ctaLink: string;
}

const slides: SlideData[] = [
  {
    id: "slide-1",
    number: "01",
    bgImage: "/images/hero/hero-slide-1.webp",
    eyebrowLine1: "PREMIUM UNISEX SALON",
    eyebrowLine2: "BY SEEMATTI",
    title1: "More Than",
    title2: "Just a",
    titleBold: "Salon",
    italicSub: "It's a Beautiful Experience",
    description: "Where expert care, modern techniques and personalised attention come together to bring out the best in you — always.",
    ctaText: "EXPLORE SERVICES",
    ctaLink: "/services/",
  },
  {
    id: "slide-2",
    number: "02",
    bgImage: "/images/hero/hero-slide-2.webp",
    eyebrowLine1: "HAIR ARTISTRY & SPA",
    eyebrowLine2: "BY SEEMATTI",
    title1: "Couture Hair",
    title2: "Artistry &",
    titleBold: "Care",
    italicSub: "Crafted with Precision & Passion",
    description: "From restorative Fusio Dose and Caviar rituals to hand-painted Balayage, Botox, and Nanoplasty transformations.",
    ctaText: "DISCOVER HAIR CARE",
    ctaLink: "/hair-artistry-spa/",
  },
  {
    id: "slide-3",
    number: "03",
    bgImage: "/images/hero/hero-slide-3.webp",
    eyebrowLine1: "THE BRIDAL EXPERIENCE",
    eyebrowLine2: "BY SEEMATTI",
    title1: "Your Day.",
    title2: "Your",
    titleBold: "Grace",
    italicSub: "Your Signature Look",
    description: "Bespoke bridal journeys combining century-long Seematti heritage with high-definition and airbrush makeup.",
    ctaText: "EXPLORE BRIDAL",
    ctaLink: "/bridal/",
  },
];
---

<section
  id="hero-slider"
  class="relative w-full overflow-hidden bg-[#F7F0E4] border-b border-[#E8D5B7]/50 select-none"
  aria-label="S For Swag Hero Banner"
>
  <!-- Fixed aspect ratio container matching reference 2.5:1 ratio -->
  <div class="relative w-full min-h-[460px] sm:min-h-[500px] lg:min-h-[520px] xl:min-h-[540px]">
    
    {slides.map((slide, index) => {
      const isFirst = index === 0;
      return (
        <div
          class={`hero-slide absolute inset-0 w-full h-full bg-cover bg-no-repeat transition-opacity duration-700 ease-in-out ${
            isFirst ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
          }`}
          style={`background-image: url('${slide.bgImage}'); background-position: center right;`}
          data-slide-index={index}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${slides.length}`}
        >
          <!-- Text Content Wrapper -->
          <div class="max-w-7xl mx-auto h-full px-6 sm:px-10 lg:px-12 flex items-center">
            <div class="w-full sm:w-[58%] md:w-[52%] lg:w-[48%] py-8 sm:py-12 z-20">
              
              <!-- Eyebrow with decorative gold underline -->
              <div class="space-y-0.5 mb-3 sm:mb-4">
                <p class="text-[10px] sm:text-xs uppercase tracking-[0.24em] text-[#8E652E] font-medium">
                  {slide.eyebrowLine1}
                </p>
                <p class="text-[10px] sm:text-xs uppercase tracking-[0.24em] text-[#8E652E] font-medium">
                  {slide.eyebrowLine2}
                </p>
                <div class="w-10 sm:w-12 h-[1px] bg-[#A77A3F] mt-2"></div>
              </div>

              <!-- Main Heading matching exact reference typography -->
              <div class="space-y-1">
                <h1 class="text-3xl sm:text-5xl lg:text-[3.6rem] font-serif text-[#28221C] leading-[1.06] tracking-tight">
                  {slide.title1} <br />
                  <span class="font-normal">{slide.title2}</span> <span class="font-semibold">{slide.titleBold}</span>
                </h1>
                <p class="text-xl sm:text-2xl lg:text-3xl font-serif italic text-[#8E652E] font-normal pt-1 mb-3">
                  {slide.italicSub}
                </p>
              </div>

              <!-- Supporting Paragraph -->
              <p class="text-xs sm:text-sm text-[#5C4D3E] max-w-sm sm:max-w-md leading-relaxed mb-6 font-normal">
                {slide.description}
              </p>

              <!-- Filled Pill CTA Button -->
              <div>
                <a
                  href={slide.ctaLink}
                  class="inline-flex items-center gap-2 px-6 sm:px-7 py-2.5 sm:py-3 rounded-full bg-[#916938] hover:bg-[#7A5526] text-[#FFFCF6] text-[10px] sm:text-[11px] uppercase tracking-[0.16em] font-medium shadow-xs transition-all duration-300 group"
                >
                  <span>{slide.ctaText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>

            </div>
          </div>
        </div>
      );
    })}

    <!-- Vertical Label on Far Right Edge (from reference image) -->
    <div class="hidden lg:flex flex-col items-center gap-4 absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 text-[9px] uppercase tracking-[0.3em] text-[#8E7864] select-none z-20 pointer-events-none">
      <span class="rotate-90 origin-center whitespace-nowrap">HAIR</span>
      <span class="w-1 h-1 rounded-full bg-[#A77A3F]/50"></span>
      <span class="rotate-90 origin-center whitespace-nowrap">NAILS</span>
      <span class="w-1 h-1 rounded-full bg-[#A77A3F]/50"></span>
      <span class="rotate-90 origin-center whitespace-nowrap">BEAUTY</span>
      <span class="w-1 h-1 rounded-full bg-[#A77A3F]/50"></span>
      <span class="rotate-90 origin-center whitespace-nowrap">BRIDAL</span>
    </div>

    <!-- Bottom Right Pagination Controls (01, 02, 03) -->
    <div
      class="absolute bottom-4 sm:bottom-6 right-8 sm:right-16 flex items-center gap-3 z-30 font-mono text-xs tracking-widest"
      aria-label="Slider Pagination"
    >
      {slides.map((s, index) => {
        const isFirst = index === 0;
        return (
          <button
            type="button"
            class="slide-nav-btn cursor-pointer py-1 px-1 transition-all flex items-center gap-1.5 focus:outline-none"
            data-target={index}
            aria-label={`Go to slide ${s.number}`}
            aria-selected={isFirst ? "true" : "false"}
          >
            <span class={`slide-line h-[1.5px] transition-all duration-300 ${isFirst ? 'w-4 bg-[#A77A3F]' : 'hidden w-0'}`}></span>
            <span class={`slide-num font-semibold transition-colors ${isFirst ? 'text-[#A77A3F]' : 'text-[#8E7864] hover:text-[#4A321C]'}`}>
              {s.number}
            </span>
          </button>
        );
      })}
    </div>

  </div>
</section>

<script>
  function initHeroSlider() {
    const slider = document.getElementById('hero-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll<HTMLElement>('.hero-slide');
    const navBtns = slider.querySelectorAll<HTMLButtonElement>('.slide-nav-btn');
    if (slides.length === 0 || navBtns.length === 0) return;

    let currentIndex = 0;
    let autoSlideTimer: number | null = null;
    const intervalMs = 6000;

    function goToSlide(targetIndex: number) {
      if (targetIndex === currentIndex) return;

      slides.forEach((slide, idx) => {
        if (idx === targetIndex) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      navBtns.forEach((btn, idx) => {
        const numSpan = btn.querySelector('.slide-num');
        const lineSpan = btn.querySelector('.slide-line');

        if (idx === targetIndex) {
          btn.setAttribute('aria-selected', 'true');
          numSpan?.classList.remove('text-[#8E7864]');
          numSpan?.classList.add('text-[#A77A3F]');
          lineSpan?.classList.remove('hidden', 'w-0');
          lineSpan?.classList.add('w-4', 'bg-[#A77A3F]');
        } else {
          btn.setAttribute('aria-selected', 'false');
          numSpan?.classList.remove('text-[#A77A3F]');
          numSpan?.classList.add('text-[#8E7864]');
          lineSpan?.classList.add('hidden', 'w-0');
          lineSpan?.classList.remove('w-4', 'bg-[#A77A3F]');
        }
      });

      currentIndex = targetIndex;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }

    function startAutoSlide() {
      stopAutoSlide();
      autoSlideTimer = window.setInterval(nextSlide, intervalMs);
    }

    function stopAutoSlide() {
      if (autoSlideTimer !== null) {
        clearInterval(autoSlideTimer);
        autoSlideTimer = null;
      }
    }

    navBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = parseInt(btn.getAttribute('data-target') || '0', 10);
        goToSlide(target);
        startAutoSlide();
      });
    });

    slider.addEventListener('mouseenter', stopAutoSlide);
    slider.addEventListener('mouseleave', startAutoSlide);

    startAutoSlide();
  }

  initHeroSlider();
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
