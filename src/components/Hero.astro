---
import { siteConfig } from '../data/site';

const slides = [
  {
    id: 'hero-slide-1',
    image: '/images/hero/3 images 1st.png',
    width: 750, height: 1000,
    alt: 'S For Swag couture unisex salon models in profile with glowing skin and precision styling',
    eyebrow: 'Premium unisex salon',
    title: 'More Than Just a Salon',
    titleLine: 'More Than', titleEnd: 'Just a', titleAccent: 'Salon',
    subtitle: "It's a Beautiful Experience",
    description: 'Where expert care, modern techniques and personalised attention come together to bring out the best in you — for women and men.',
    cta: 'Explore services', href: '/services/',
  },
  {
    id: 'hero-slide-2',
    image: '/images/hero/3 images 3rd.png',
    width: 600, height: 750,
    alt: 'Dapper male model with styled hair and precision fade in tailored black suit',
    eyebrow: "Men's grooming & hair care",
    title: 'Precision Grooming & Care',
    titleLine: 'Precision', titleEnd: 'Grooming &', titleAccent: 'Care',
    subtitle: 'Crafted for the Modern Gentleman',
    description: 'From invigorating hot oil scalp therapies and L’Oréal hair spas to beard sculpting, de-tan, and natural tone restoration.',
    cta: "Explore services", href: '/hair-artistry-spa/mens-hair-care/',
  },
  {
    id: 'hero-slide-3',
    image: '/images/hero/3 images 2nd.png',
    width: 846, height: 989,
    alt: 'Beauty model with luminous makeup, gold earrings and a champagne satin shawl',
    eyebrow: 'The bridal experience',
    title: 'Your Day. Your Grace',
    titleLine: 'Your Day', titleEnd: 'Your', titleAccent: 'Grace',
    subtitle: 'Your Signature Look',
    description: 'Bespoke bridal journeys combining century-long Seematti heritage with high-definition and airbrush makeup.',
    cta: 'Explore services', href: '/bridal/',
  },
];
---

<section id="hero-slider" class="hero" aria-label="S For Swag beauty experiences" aria-roledescription="carousel">
  <hero-carousel data-interval="4000">
    <div class="hero-stage">
      {slides.map((slide, index) => {
        const Heading = index === 0 ? 'h1' : 'h2';
        return (
          <div
            id={slide.id}
            class={`hero-slide hero-slide-${index + 1}`}
            data-slide
            data-active={index === 0 ? 'true' : 'false'}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}: ${slide.title}`}
            aria-hidden={index !== 0 ? 'true' : 'false'}
            inert={index !== 0}
          >
            <div class="hero-copy">
              <p class="hero-eyebrow">{slide.eyebrow}<span>{siteConfig.byLine}</span></p>
              <Heading class="hero-heading">
                {slide.titleLine}<br />
                {slide.titleEnd}{' '}<strong>{slide.titleAccent}</strong>
              </Heading>
              <p class="hero-subtitle font-serif">{slide.subtitle}</p>
              <p class="hero-description">{slide.description}</p>
              <a href={slide.href} class="hero-cta luxury-pill-btn">
                {slide.cta}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12h15m-5-5 5 5-5 5" />
                </svg>
              </a>
            </div>
            <div class="hero-visual">
              <img
                class="hero-model"
                src={slide.image}
                alt={slide.alt}
                width={slide.width}
                height={slide.height}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
                decoding="async"
              />
            </div>
          </div>
        );
      })}
    </div>

    <!---<p class="hero-services" aria-hidden="true">Hair <span>·</span> Nails <span>·</span> Beauty <span>·</span> Bridal <span>·</span> Men's Grooming</p>-->
    <div class="hero-controls" role="group" aria-label="Slideshow controls">
      <div class="hero-pagination" role="group" aria-label="Choose a slide">
        {slides.map((slide, index) => (
          <button
            type="button"
            class="hero-indicator"
            data-slide-target={index}
            aria-label={`Show slide ${index + 1}: ${slide.title}`}
            aria-controls={slide.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span aria-hidden="true" class="hero-dot"></span>
          </button>
        ))}
      </div>
      <span class="hero-controls-divider" aria-hidden="true"></span>
      <button type="button" class="hero-rotation" data-rotation aria-label="Pause slideshow">
        <svg class="hero-pause-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M4 3h2v10H4zm6 0h2v10h-2z" />
        </svg>
        <svg class="hero-play-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="m5 3 8 5-8 5z" />
        </svg>
      </button>
    </div>
    <p class="sr-only" data-slide-status aria-live="polite" aria-atomic="true"></p>
  </hero-carousel>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--color-champagne);
    background: var(--color-bg-primary) url('/images/hero/background image.jpg') center center / cover no-repeat;
    margin-top: calc(-1 * (var(--site-header-height, 73px) + var(--header-gap, 16px)));
    padding-top: calc(var(--site-header-height, 73px) + var(--header-gap, 16px));
  }
  hero-carousel { display: block; }
  .hero-stage {
    display: grid;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(24px, 4vw, 64px);
  }
  /* Overlapping grid items reserve the tallest slide's space, even when hidden. */
  .hero-slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-width: 0;
    min-height: clamp(540px, 43vw, 610px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 650ms ease, visibility 650ms;
  }
  .hero-slide[data-active='true'] { visibility: visible; opacity: 1; pointer-events: auto; z-index: 1; }
  .hero-copy {
    align-self: center;
    position: relative;
    z-index: 2;
    padding-block: 64px 88px;
    padding-right: 12px;
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 500ms ease, transform 700ms ease;
  }
  .hero-slide[data-active='true'] .hero-copy { opacity: 1; transform: translateX(0); }
  .hero-eyebrow {
    margin-bottom: 25px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.8;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .hero-eyebrow span { display: block; }
  .hero-eyebrow::after {
    content: '';
    display: block;
    width: 42px;
    height: 1px;
    margin-top: 14px;
    background: var(--color-gold);
  }
  .hero-heading {
    font-family: var(--font-primary-display, 'Crawling', 'CrawlingPersonalUsed', 'Cormorant Garamond', Georgia, serif);
    color: var(--color-text-main);
    font-size: clamp(48px, 4.7vw, 64px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .hero-heading strong { font-weight: 600; }
  .hero-subtitle {
    margin-top: 12px;
    color: var(--color-gold-dark);
    font-size: clamp(23px, 2.1vw, 29px);
    line-height: 1.2;
    font-style: italic;
  }
  .hero-description {
    max-width: 385px;
    margin-top: 20px;
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.85;
  }
  .hero-cta {
    min-height: 46px;
    margin-top: 28px;
    gap: 18px;
    color: var(--color-white);
    background: var(--color-gold-dark);
    font-size: 10px;
    letter-spacing: 0.16em;
    box-shadow: 0 4px 12px rgb(74 50 28 / 8%);
  }
  .hero-cta:hover { background: var(--color-brown-deep); }
  .hero-cta svg { flex-shrink: 0; transition: transform 200ms ease; }
  .hero-cta:hover svg { transform: translateX(3px); }
  .hero-visual { position: relative; min-width: 0; align-self: stretch; }
  .hero-model {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    height: calc(100% - 32px);
    object-fit: contain;
    object-position: center bottom;
    opacity: 0;
    transform: translateX(22px);
    transition: opacity 700ms ease, transform 900ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }
  .hero-slide[data-active='true'] .hero-model { opacity: 1; transform: translateX(0); }
  .hero-services {
    position: absolute;
    right: 22px;
    top: 50%;
    z-index: 2;
    display: flex;
    gap: 14px;
    align-items: center;
    writing-mode: vertical-rl;
    transform: translateY(-50%);
    color: var(--color-gold-dark);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .hero-controls {
    position: absolute;
    z-index: 3;
    bottom: 18px;
    left: max(24px, calc((100% - 1280px) / 2 + 64px));
    display: flex;
    align-items: center;
    visibility: hidden;
  }
  [data-ready] .hero-controls { visibility: visible; }
  .hero-pagination { display: flex; }
  .hero-indicator, .hero-rotation {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-gold-dark);
    cursor: pointer;
  }
  .hero-dot {
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: background 250ms ease, box-shadow 250ms ease;
  }
  .hero-indicator[aria-pressed='true'] .hero-dot {
    background: currentColor;
    box-shadow: 0 0 0 5px var(--color-bg-primary), 0 0 0 6px rgb(132 93 43 / 45%);
  }
  .hero-indicator:hover, .hero-rotation:hover { background: rgb(232 213 183 / 50%); }
  .hero-controls-divider { width: 1px; height: 14px; margin-inline: 8px; background: var(--color-gold-light); }
  .hero-play-icon, [data-paused='true'] .hero-pause-icon { display: none; }
  [data-paused='true'] .hero-play-icon { display: block; }
  .hero :is(a, button):focus-visible { outline: 2px solid var(--color-brown-deep); outline-offset: 4px; }
  @media (min-width: 1280px) {
    .hero-model { width: calc(100% + 30px); max-width: none; right: -100px; }
    .hero-slide-1 .hero-model { right: -40px; }
  }
  @media (max-width: 1023px) {
    .hero { background-position: center; }
    .hero-services { display: none; }
    .hero-heading { font-size: clamp(42px, 5.3vw, 54px); }
    .hero-copy { padding-block: 56px 88px; }
  }
  @media (max-width: 639px) {
    .hero { background-position: 35% center; }
    .hero-stage { padding-inline: 24px; }
    .hero-slide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr clamp(280px, 78vw, 390px);
      min-height: 0;
    }
    .hero-copy { align-self: start; padding: 44px 0 16px; }
    .hero-eyebrow { margin-bottom: 20px; font-size: 9px; }
    .hero-eyebrow::after { margin-top: 10px; }
    .hero-heading { font-size: clamp(40px, 10.8vw, 54px); }
    .hero-subtitle { max-width: 360px; font-size: 24px; }
    .hero-description { max-width: 360px; margin-top: 16px; font-size: 12px; }
    .hero-cta { margin-top: 22px; }
    .hero-model { height: 100%; width: 100%; right: 0; object-position: center bottom; }
    .hero-controls { bottom: 10px; left: 24px; border-radius: 30px; background: rgb(247 240 228 / 92%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide, .hero-copy, .hero-model, .hero-dot, .hero-cta, .hero-cta svg { transition: none; transform: none; }
  }
</style>

<script>
  import '../scripts/hero-carousel';
</script>
