---
---

<section class="py-20 lg:py-28 bg-[#F7F0E4] relative overflow-hidden">
  
  <!-- Right edge botanical flourish accent -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-48 h-96 opacity-30 pointer-events-none hidden lg:block">
    <img src="/images/brand/leaf-accent.svg" alt="" class="w-full h-full object-contain" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left: Distinctive Arched Salon Interior (Span 6) -->
      <div class="lg:col-span-6 relative">
        <!-- Curved architectural frame matching the reference mockup -->
        <div class="relative overflow-hidden rounded-tl-[100px] sm:rounded-tl-[140px] rounded-tr-[40px] rounded-bl-[40px] rounded-br-[100px] sm:rounded-br-[140px] border-2 border-[#FFFCF6] shadow-xl group">
          <img
            src="/images/salon/About us.jpg"
            alt="Interior view of S For Swag luxury salon reception and styling chairs in Kochi"
            class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700"
            width="720"
            height="540"
            loading="lazy"
          />

          <!-- Delicate Arch Outline in Gold -->
          <div class="absolute inset-0 border border-[#b7802c]/30 pointer-events-none rounded-tl-[100px] sm:rounded-tl-[140px] rounded-tr-[40px] rounded-bl-[40px] rounded-br-[100px] sm:rounded-br-[140px]"></div>
        </div>
      </div>

      <!-- Right: Text Content (Span 6) -->
      <div class="lg:col-span-6 space-y-6 lg:pl-4">
        
        <!-- Eyebrow -->
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-[0.24em] text-[#75451d] font-semibold">About Us</span>
          <span class="w-12 h-[1px] bg-[#b7802c]"></span>
        </div>

        <!-- Heading -->
        <h2 class="text-3xl sm:text-5xl font-serif text-[#28221C] leading-[1.15]">
          Welcome to <br />
          <span class="italic font-normal">S for Swag</span>
        </h2>

        <!-- Paragraphs -->
        <div class="space-y-4 text-sm sm:text-base text-[#5C4D3E] leading-relaxed">
          <p>
            S for Swag is a premium unisex salon by Seematti, designed for those who believe self-care is not a luxury, but a lifestyle. We blend expertise with artistry to offer a seamless beauty experience — from everyday essentials to special occasions.
          </p>
          <p>
            With world-class services, a team of skilled professionals and a serene, modern space, we're here to help you look good, feel confident and be your best self.
          </p>
        </div>

        <!-- Philosophy highlight quote box -->
        <div class="p-5 rounded-2xl bg-[#F5ECDB]/60 border-l-2 border-[#b7802c] text-xs sm:text-sm text-[#75451d] italic font-serif leading-relaxed">
          "Beauty is not about changing who you are. It is about bringing out what feels right for you."
        </div>

        <!-- CTA Link -->
        <div class="pt-2">
          <a
            href="/about/"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] font-semibold text-[#75451d] hover:text-[#75451d] transition-colors group"
          >
            <span>Our Story</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
