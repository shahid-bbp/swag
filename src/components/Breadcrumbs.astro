---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`text-[10px] sm:text-[11px] uppercase tracking-[0.22em] text-[#8E7864] bg-transparent ${className}`}>
  <div class="flex items-center gap-2 flex-wrap">
    <a href="/" class="hover:text-[#b7802c] transition-colors font-medium">
      Home
    </a>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <div class="flex items-center gap-2">
          <span class="text-[#b7802c]/50 select-none">/</span>
          {isLast ? (
            <span class="text-[#75451d] font-semibold" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-[#b7802c] transition-colors font-medium">
              {item.name}
            </a>
          )}
        </div>
      );
    })}
  </div>
</nav>
