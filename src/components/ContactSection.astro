---
import { siteConfig } from '../data/site';
---

<section class="py-20 lg:py-24 bg-[#F7F0E4] border-t border-[#E8D5B7]/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left: Heading & Appointment CTA (Span 5) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="space-y-2">
          <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#8E652E] font-semibold">
            Get in Touch
          </span>
          <h2 class="text-3xl sm:text-5xl font-serif text-[#28221C] leading-[1.15]">
            We're Here for You
          </h2>
          <p class="text-sm text-[#5C4D3E] leading-relaxed pt-1">
            Have a question? Want to book an appointment? Our team is always happy to help.
          </p>
        </div>

        <div>
          <a
            href="/contact/#appointment"
            class="luxury-pill-btn luxury-pill-outline group"
          >
            <span>Book an Appointment</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Center: Contact Points (Span 4) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Phone -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full border border-[#A77A3F]/40 flex items-center justify-center text-[#A77A3F] shrink-0 bg-[#FFFCF6]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div>
            <span class="text-[11px] uppercase tracking-wider text-[#8E7864] block font-medium">Call Us</span>
            <a href={`tel:${siteConfig.phone}`} class="text-sm font-semibold text-[#4A321C] hover:text-[#A77A3F] transition-colors">
              {siteConfig.phoneFormatted}
            </a>
          </div>
        </div>

        <!-- WhatsApp -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full border border-[#A77A3F]/40 flex items-center justify-center text-[#A77A3F] shrink-0 bg-[#FFFCF6]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div>
            <span class="text-[11px] uppercase tracking-wider text-[#8E7864] block font-medium">WhatsApp Us</span>
            <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[#4A321C] hover:text-[#A77A3F] transition-colors">
              {siteConfig.phoneFormatted}
            </a>
          </div>
        </div>

        <!-- Address & Directions -->
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full border border-[#A77A3F]/40 flex items-center justify-center text-[#A77A3F] shrink-0 bg-[#FFFCF6]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="space-y-1">
            <span class="text-[11px] uppercase tracking-wider text-[#8E7864] block font-medium">Salon Location</span>
            <p class="text-xs text-[#4A321C] leading-relaxed">
              Opp. Seematti, MG Road,<br />
              Kochi – 682018
            </p>
            <a
              href={siteConfig.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-[#A77A3F] hover:underline inline-block pt-0.5"
            >
              Get Directions &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Stylized Aesthetic Map Card (Span 3) -->
      <div class="lg:col-span-3">
        <a
          href={siteConfig.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block group relative rounded-2xl overflow-hidden border border-[#E8D5B7] bg-[#EFE2CE] p-4 text-center shadow-sm hover:shadow-md transition-all hover:border-[#A77A3F]"
          aria-label="Open S For Swag on Google Maps"
        >
          <!-- Stylized map graphic representation -->
          <div class="h-36 rounded-xl bg-[#F7F0E4] border border-[#E8D5B7] flex flex-col items-center justify-center relative overflow-hidden p-3">
            <!-- Road lines representation -->
            <div class="absolute inset-0 opacity-20 pointer-events-none">
              <svg viewBox="0 0 200 120" class="w-full h-full" fill="none" stroke="#A77A3F" stroke-width="2">
                <path d="M-10 80 Q90 60 210 30" />
                <path d="M40 0 L160 120" stroke-dasharray="4 4" />
                <path d="M120 0 L80 120" />
              </svg>
            </div>
            
            <!-- Pin Badge -->
            <div class="relative z-10 flex flex-col items-center">
              <div class="w-8 h-8 rounded-full bg-[#A77A3F] text-[#FFFCF6] flex items-center justify-center shadow-md mb-1.5 group-hover:scale-110 transition-transform">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <span class="text-[11px] font-serif font-bold text-[#4A321C]">S for Swag</span>
              <span class="text-[9px] uppercase tracking-wider text-[#8E7864]">Opp. Seematti, MG Road</span>
            </div>
          </div>

          <div class="pt-3 flex items-center justify-center gap-1.5 text-xs font-semibold text-[#8E652E] group-hover:text-[#4A321C]">
            <span>Open in Google Maps</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
