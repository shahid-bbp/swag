---
import { siteConfig } from '../data/site';

export interface Props {
  preselectedService?: string;
  title?: string;
  subtitle?: string;
}

const {
  preselectedService = '',
  title = "Book an Appointment",
  subtitle = "Reserve your personalized beauty and styling session with our master artists.",
} = Astro.props;

const formspreeEndpoint = (import.meta.env.FORMSPREE_ENDPOINT || '').trim();
const isEndpointConfigured = Boolean(formspreeEndpoint && formspreeEndpoint.trim() !== '');

const serviceOptions = [
  "Bridal Studio — Silver Bride Package",
  "Bridal Studio — Gold Bride Package",
  "Bridal Studio — Platinum Bride Package",
  "Bridal Makeup — Traditional / HD",
  "Bridal Makeup — Airbrush",
  "Bridal Hairstyle & Saree Draping",
  "Hair Artistry — Hair Spa & Scalp Therapy",
  "Hair Artistry — Texture / Botox / Nanoplasty",
  "Hair Artistry — Balayage / Global Colour",
  "Beauty Lounge — Signature Facial & Clean Up",
  "Beauty Lounge — Precision Threading & Grooming",
  "Beauty Lounge — Full Body / Face Detan",
  "Beauty Lounge — Stripless / Strip Waxing",
  "Nail Studio — Gel Extensions / Gel Polish",
  "Nail Studio — Luxury Spa Manicure & Pedicure",
  "Nail Studio — Nail Art & Chrome / Ombre Addons",
  "Body Wellness — Aroma Bliss Massage",
  "Body Wellness — Deep Tissue / Swedish Massage",
  "Body Wellness — Reflexology & Indian Head Massage",
  "General Consultation / Custom Package",
];
if (preselectedService && !serviceOptions.includes(preselectedService)) serviceOptions.unshift(preselectedService);
---

<div id="appointment-form-wrapper" class="bg-[#FFFCF6] border border-[#eeda9b] rounded-3xl p-6 sm:p-10 shadow-sm relative overflow-hidden">
  
  <!-- Subtle decorative top contour -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#C5A059] via-[#b7802c] to-[#75451d]"></div>

  <div class="mb-8 text-center max-w-xl mx-auto">
    <span class="text-[0.6875rem] uppercase tracking-[0.24em] text-[#b7802c] font-semibold">Concierge Service</span>
    <h2 class="text-3xl sm:text-4xl font-serif text-[#75451d] mt-1 mb-3">{title}</h2>
    <p class="text-sm text-[#6C5D4F] leading-relaxed">{subtitle}</p>
  </div>

  {!isEndpointConfigured && (
    <div class="mb-6 p-4 rounded-xl bg-[#F7F0E4] border border-[#eeda9b] text-xs text-[#5C4D3E]">
      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 text-[#b7802c] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>
          <p class="font-semibold text-[#75451d]">Send your enquiry on WhatsApp</p>
          <p class="mt-1 leading-relaxed">
            Fill in your preferences below to prepare a message, then open WhatsApp to send it. Reception will confirm availability. You can also call <a href={`tel:${siteConfig.phone}`} class="font-semibold text-[#75451d] underline">{siteConfig.phoneFormatted}</a>.
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- Success Notification Box -->
  <div id="form-success-message" class="hidden mb-6 p-6 rounded-2xl bg-[#F4F9F2] border border-[#B7DDB2] text-center animate-fade-in" role="status" aria-live="polite">
    <div class="w-12 h-12 mx-auto rounded-full bg-[#3B8246]/10 flex items-center justify-center text-[#3B8246] mb-3">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3 class="text-xl font-serif text-[#24522B] mb-1 font-semibold">{isEndpointConfigured ? 'Appointment request received' : 'Your enquiry is ready to send'}</h3>
    <p class="text-sm text-[#46694C] leading-relaxed max-w-md mx-auto">
      {isEndpointConfigured ? 'The team will contact you to confirm availability and appointment details.' : 'Your request has not been sent yet. Open WhatsApp below, review your message and send it to reception.'}
    </p>
    <div class="mt-5">
      <a
        id="enquiry-whatsapp-link"
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#24522B] underline hover:text-[#18391D]"
      >
        <span>{isEndpointConfigured ? 'Chat with reception' : 'Open WhatsApp to send'}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Error Notification Box -->
  <div id="form-error-message" class="hidden mb-6 p-4 rounded-xl bg-[#FDF2F2] border border-[#F8B4B4] text-xs text-[#9B1C1C]" role="alert">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="form-error-text">There was an issue submitting your request. Please try again or contact us directly on +91 90610 77722.</span>
    </div>
  </div>

  <noscript><p class="mb-6 text-sm">Please <a href={siteConfig.whatsappUrl} class="underline">contact us on WhatsApp</a> or <a href={`tel:${siteConfig.phone}`} class="underline">call reception</a> to enquire.</p><style is:inline>#appointment-form { display: none; }</style></noscript>
  <form id="appointment-form" data-endpoint={formspreeEndpoint} data-whatsapp={siteConfig.whatsappNumber} class="space-y-5" novalidate>
    <!-- Spam Honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for="gotcha-field">Leave this empty</label>
      <input type="text" id="gotcha-field" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Full Name -->
      <div>
        <label for="client-name" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Full Name <span class="text-[#b7802c]">*</span>
        </label>
        <input
          type="text"
          id="client-name"
          name="name" autocomplete="name"
          required
          placeholder="e.g. Anjali Menon"
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all placeholder-[#A39485]"
        />
        <p class="client-error text-xs text-[#C53030] mt-1 hidden" id="error-name">Please provide your full name.</p>
      </div>

      <!-- Phone Number -->
      <div>
        <label for="client-phone" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Phone Number <span class="text-[#b7802c]">*</span>
        </label>
        <input
          type="tel"
          id="client-phone"
          name="phone" autocomplete="tel"
          required
          placeholder="e.g. +91 98765 43210"
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all placeholder-[#A39485]"
        />
        <p class="client-error text-xs text-[#C53030] mt-1 hidden" id="error-phone">Please enter a valid phone number.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Email Address (Optional) -->
      <div>
        <label for="client-email" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Email Address <span class="text-[#8E7864] text-[10px] font-normal lowercase">(optional)</span>
        </label>
        <input
          type="email"
          id="client-email"
          name="email" autocomplete="email"
          placeholder="e.g. anjali@example.com"
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all placeholder-[#A39485]"
        />
        <p class="client-error text-xs text-[#C53030] mt-1 hidden" id="error-email">Please enter a valid email address.</p>
      </div>

      <!-- Preferred Service -->
      <div>
        <label for="client-service" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Preferred Service <span class="text-[#b7802c]">*</span>
        </label>
        <select
          id="client-service"
          name="service"
          required
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all"
        >
          <option value="" disabled selected={!preselectedService}>Select a service or package</option>
          {serviceOptions.map((opt) => (
            <option value={opt} selected={preselectedService === opt}>
              {opt}
            </option>
          ))}
        </select>
        <p class="client-error text-xs text-[#C53030] mt-1 hidden" id="error-service">Please select your preferred service.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Preferred Date -->
      <div>
        <label for="client-date" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Preferred Date <span class="text-[#8E7864] text-[10px] font-normal lowercase">(optional)</span>
        </label>
        <input
          type="date"
          id="client-date"
          name="date"
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all"
        />
      </div>

      <!-- Preferred Time -->
      <div>
        <label for="client-time" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
          Preferred Time Slot <span class="text-[#8E7864] text-[10px] font-normal lowercase">(optional)</span>
        </label>
        <select
          id="client-time"
          name="time"
          class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all"
        >
          <option value="Flexible">Flexible / Anytime</option>
          <option value="Morning (9:30 AM – 12:00 PM)">Morning (9:30 AM – 12:00 PM)</option>
          <option value="Afternoon (12:00 PM – 3:30 PM)">Afternoon (12:00 PM – 3:30 PM)</option>
          <option value="Evening (3:30 PM – 7:30 PM)">Evening (3:30 PM – 7:30 PM)</option>
        </select>
      </div>
    </div>

    <!-- Message / Special Requests -->
    <div>
      <label for="client-notes" class="block text-xs font-semibold uppercase tracking-wider text-[#75451d] mb-1.5">
        Special Notes or Hair/Skin Requirements <span class="text-[#8E7864] text-[10px] font-normal lowercase">(optional)</span>
      </label>
      <textarea
        id="client-notes"
        name="notes"
        rows="3"
        placeholder="Tell us about your wedding date, hair texture, preferred stylist, or any special occasion details..."
        class="w-full px-4 py-3 rounded-xl bg-[#F7F0E4]/60 border border-[#eeda9b] text-[#28221C] text-sm focus:outline-none focus:ring-2 focus:ring-[#b7802c] focus:border-transparent transition-all placeholder-[#A39485]"
      ></textarea>
    </div>

    <!-- Consent Checkbox -->
    <div class="pt-1">
      <label class="flex items-start gap-3 cursor-pointer">
        <input
          type="checkbox"
          id="client-consent"
          name="consent"
          required
          class="mt-1 w-4 h-4 rounded text-[#b7802c] border-[#eeda9b] focus:ring-[#b7802c]"
        />
        <span class="text-xs text-[#5C4D3E] leading-relaxed">
          I consent to S For Swag contacting me regarding this appointment enquiry in accordance with the{' '}
          <a href="/privacy-policy/" target="_blank" class="text-[#b7802c] underline hover:text-[#75451d]">Privacy Policy</a>.
        </span>
      </label>
      <p class="client-error text-xs text-[#C53030] mt-1 hidden" id="error-consent">Consent is required to submit an enquiry.</p>
    </div>

    <!-- Submit CTA & Loading Indicator -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#b7802c] hover:bg-[#75451d] text-[#FFFCF6] text-xs uppercase tracking-[0.18em] font-medium transition-all shadow-sm flex items-center justify-center gap-2 group cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="btn-text">{isEndpointConfigured ? 'Send appointment enquiry' : 'Prepare WhatsApp enquiry'}</span>
        <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="4" stroke="currentColor" stroke-opacity="0.25"></circle>
          <path d="M4 12a8 8 0 018-8" stroke-width="4" stroke="currentColor"></path>
        </svg>
        <svg id="btn-arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>

      <div class="text-center sm:text-right text-xs text-[#6C5D4F]">
        <p>Immediate assistance? Call <a href={`tel:${siteConfig.phone}`} class="font-semibold text-[#75451d] hover:text-[#b7802c]">{siteConfig.phoneFormatted}</a></p>
      </div>
    </div>
  </form>
</div>

<script>
  import '../scripts/enquiry-form';
</script>
